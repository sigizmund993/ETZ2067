# ---------------------------------------------------------------------------
# Геометрия-помощники
# ---------------------------------------------------------------------------
V = App.Vector


def box(x0, x1, y0, y1, z0, z1):
    return Part.makeBox(x1 - x0, y1 - y0, z1 - z0, V(x0, y0, z0))


def cyl(r, z0, z1, x=0.0, y=0.0):
    return Part.makeCylinder(r, z1 - z0, V(x, y, z0))


def cyl_x(r, x0, x1, y=0.0, z=0.0):
    return Part.makeCylinder(r, x1 - x0, V(x0, y, z), V(1, 0, 0))


def tube(ro, ri, z0, z1, x=0.0, y=0.0):
    return cyl(ro, z0, z1, x, y).cut(cyl(ri, z0 - 1, z1 + 1, x, y))


def hexagon(s, z0, z1, x=0.0, y=0.0, rot=0.0):
    """Шестигранник «под ключ s». rot=0: вершины на ±Y, грани ⟂ X —
    так гайка скользит вдоль Y по пазу шириной s."""
    rc = s / math.sqrt(3.0)
    pts = [V(x + rc * math.cos(math.radians(90 + rot + 60 * i)),
             y + rc * math.sin(math.radians(90 + rot + 60 * i)), z0) for i in range(7)]
    return Part.Face(Part.makePolygon(pts)).extrude(V(0, 0, z1 - z0))


def rounded_rect(x0, x1, y0, y1, z0, z1, r):
    b = box(x0 + r, x1 - r, y0, y1, z0, z1).fuse(box(x0, x1, y0 + r, y1 - r, z0, z1))
    for cx in (x0 + r, x1 - r):
        for cy in (y0 + r, y1 - r):
            b = b.fuse(cyl(r, z0, z1, cx, cy))
    return b.removeSplitter()


def slot(r, z0, z1, p, u, half):
    """Паз: окружность r, протянутая на ±half вдоль единичного u."""
    a = V(p.x - u.x * half, p.y - u.y * half, 0)
    b = V(p.x + u.x * half, p.y + u.y * half, 0)
    s = cyl(r, z0, z1, a.x, a.y).fuse(cyl(r, z0, z1, b.x, b.y))
    n = V(-u.y, u.x, 0)
    pts = [a + n * r, b + n * r, b - n * r, a - n * r, a + n * r]
    pts = [V(q.x, q.y, z0) for q in pts]
    s = s.fuse(Part.Face(Part.makePolygon(pts)).extrude(V(0, 0, z1 - z0)))
    return s.removeSplitter()


def soften(shape, r, zs, name):
    """Скруглить периметр детали на высотах zs (п. 3.2 ЕТЗ: кромки
    скруглены). Берётся внешний контур верхних граней на высотах zs; если
    ядро не справилось — деталь остаётся как есть и в отчёт идёт строка."""
    edges = []
    for f in shape.Faces:
        if f.Surface.__class__.__name__ != "Plane":
            continue
        n = f.normalAt(0, 0)
        c = f.CenterOfMass
        if n.z > 0.99 and any(abs(c.z - z) < 1e-6 for z in zs):
            edges += f.OuterWire.Edges
    for rr in (r, r / 2.0, r / 4.0):      # на коротких рёбрах большой радиус не встаёт
        try:
            f = shape.makeFillet(rr, edges)
            if f.isValid() and abs(f.Volume - shape.Volume) < 0.02 * shape.Volume:
                return f
        except Exception:
            pass
    print("  !! %s: скругление кромок не построилось, деталь без него" % name)
    return shape


def cap_screw(m, L):
    """ISO 4762: опорная грань головки на z = 0, головка вверх, стержень вниз."""
    head = cyl(m["dk"] / 2.0, 0.0, m["k"])
    key = hexagon(m["s"], m["k"] - 0.6 * m["s"], m["k"] + 0.1)
    return head.cut(key).fuse(cyl(m["d"] / 2.0, -L, 0.0)).removeSplitter()


def nut(m, rot=0.0):
    """ISO 4032: низ на z = 0. rot как у hexagon()."""
    return hexagon(m["nut_s"], 0.0, m["nut_m"], rot=rot).cut(cyl(m["d"] / 2.0, -1, m["nut_m"] + 1))


def nut_pocket(m, z0, x, y, slide, rot=0.0, depth=30.0):
    """Гнездо гайки + боковой паз для заводки. slide — единичный вектор
    наружу (куда открыт паз), паз шириной «под ключ» + 0.3."""
    s = m["nut_s"] + 0.3
    h = m["nut_m"] + 0.4
    p = hexagon(s, z0, z0 + h, x, y, rot)
    ang = math.degrees(math.atan2(slide.y, slide.x))
    sl = box(0, depth, -s / 2.0, s / 2.0, z0, z0 + h)
    sl.rotate(V(0, 0, 0), V(0, 0, 1), ang)
    sl.translate(V(x, y, 0))
    return p.fuse(sl)


def involute_gear(m, z, w, bore=0.0, shift=0.0, backlash=0.12, z0=0.0, steps=6,
                  plane="xy", phase=0.0):
    """Прямозубое эвольвентное колесо, угол 20°, со смещением shift.

    plane="xy": ось колеса Z, толщина z0..z0+w, зуб 0 смотрит по углу phase
    от +X. plane="yz": ось колеса X, толщина x0..x0+w (x0 = z0), угол
    phase отсчитывается от +Y к +Z. Ось сразу строится нужная: поворот,
    сделанный rotate() у формы, живёт в её Placement и пропадает, как
    только детали присваивают свой Placement.
    """
    a = math.radians(20.0)
    rp = m * z / 2.0
    rb = rp * math.cos(a)
    ra = rp + m * (1.0 + shift)
    rf = rp - m * (1.25 - shift)
    inv = lambda t: math.tan(t) - t
    s = m * (math.pi / 2.0 + 2.0 * shift * math.tan(a)) - backlash
    half_p = s / (2.0 * rp)
    r0 = max(rb, rf)
    rs = [r0 + (ra - r0) * i / float(steps) for i in range(steps + 1)]
    fl = [(r, half_p + inv(a) - inv(math.acos(min(1.0, rb / r)))) for r in rs]
    th_base = fl[0][1]
    pts = []
    ph = math.radians(phase)
    for i in range(z):
        c = 2.0 * math.pi * i / z + ph
        tooth = [(rf, c - th_base)] + [(r, c - t) for r, t in fl] + \
                [(r, c + t) for r, t in reversed(fl)] + [(rf, c + th_base)]
        if plane == "yz":
            pts += [V(z0, r * math.cos(t), r * math.sin(t)) for r, t in tooth]
        else:
            pts += [V(r * math.cos(t), r * math.sin(t), z0) for r, t in tooth]
    pts.append(pts[0])
    if plane == "yz":
        g = Part.Face(Part.makePolygon(pts)).extrude(V(w, 0, 0))
        if bore > 0:
            g = g.cut(cyl_x(bore / 2.0, z0 - 1, z0 + w + 1))
    else:
        g = Part.Face(Part.makePolygon(pts)).extrude(V(0, 0, w))
        if bore > 0:
            g = g.cut(cyl(bore / 2.0, z0 - 1, z0 + w + 1))
    return g


def rack(m, length, w, z0, back):
    """Рейка вдоль Z: делительная прямая на y = 0, зубья в +y, основание
    до y = -back. Толщина w по X от 0. Зубья трапецией 20° (эвольвента рейки)."""
    p = math.pi * m
    ha, hf = m, 1.25 * m
    t = math.tan(math.radians(20.0))
    n = int(length / p) + 1
    prof = [V(0, -back, z0)]
    for i in range(n):
        zc = z0 + p * (i + 0.5)
        # зуб: ширина p/2 на делительной прямой
        prof += [V(0, -hf, zc - p / 4 - hf * t), V(0, ha, zc - p / 4 + ha * t),
                 V(0, ha, zc + p / 4 - ha * t), V(0, -hf, zc + p / 4 + hf * t)]
    prof += [V(0, -back, z0 + n * p), V(0, -back, z0)]
    # подрезать до length
    f = Part.Face(Part.makePolygon(prof)).extrude(V(w, 0, 0))
    return f.common(box(-1, w + 1, -back - 1, ha + 1, z0, z0 + length))


def lib_feature(rel):
    """Деталь из parts_library как есть (форма + её Placement)."""
    import os
    path = os.path.join(App.getUserAppDataDir(), "Mod", "parts_library", rel)
    if not os.path.exists(path):
        return None
    d = App.openDocument(path, True)
    try:
        best = None
        for o in d.Objects:
            sh = getattr(o, "Shape", None)
            if sh is None or sh.isNull() or sh.Volume < 1e-9:
                continue
            best = o.Shape.copy()
        return best
    finally:
        App.closeDocument(d.Name)


def sg90():
    sh = lib_feature("Electrical Parts/Servos/SG-90/Servo sg90.fcstd")
    if sh is None:      # габаритная замена
        sh = box(-5.9, 5.9, 0, 22.5, 0, 22.7).fuse(box(-5.9, 5.9, -4.7, 27.7, 15.9, 18.4))
        sh = sh.fuse(cyl(2.4, 22.7, 29.9, 0, SG_AXIS_Y))
    sh = sh.copy()
    m = sh.Placement.toMatrix()
    sh.Placement = App.Placement()
    return sh.transformGeometry(m) if not m.isUnity() else sh


# ---------------------------------------------------------------------------
# Документ-помощники
# ---------------------------------------------------------------------------
def pick_doc():
    act = App.ActiveDocument
    if act is not None and act.getObject(VS) is not None:
        return act
    for d in App.listDocuments().values():
        if d.getObject(VS) is not None:
            return d
    raise RuntimeError("не нашёл документ с VarSet " + VS)


def purge(doc, prefixes):
    for o in list(doc.Objects):
        if o.Name.startswith(prefixes) and doc.getObject(o.Name) is not None:
            doc.removeObject(o.Name)


def feat(doc, part, name, label, shape, color, alpha=0):
    o = doc.addObject("Part::Feature", name)
    o.Shape = shape
    o.Label = label
    part.addObject(o)
    if App.GuiUp:
        o.ViewObject.ShapeColor = color
        o.ViewObject.DiffuseColor = [color]
        o.ViewObject.Transparency = alpha
    return o


def container(doc, name, label, parent=None):
    p = doc.getObject(name)
    if p is None:
        p = doc.addObject("App::Part", name)
        if parent is not None:
            parent.addObject(p)
    p.Label = label
    return p


PLA = (0.93, 0.55, 0.15)       # печатные детали станины
PLA2 = (0.25, 0.55, 0.85)      # печатные детали рабочего узла
STEEL = (0.62, 0.64, 0.67)
DARK = (0.30, 0.32, 0.35)
BELT = (0.12, 0.12, 0.12)
SERVO = (0.15, 0.35, 0.80)


# ---------------------------------------------------------------------------
# Станина
# ---------------------------------------------------------------------------
def build_frame(doc, d, e):
    """Основание, стенки, плиты моторов, вал шкивов. Глобальные координаты.

    Моторы ПЕРЕВЁРНУТЫ: стоят фланцем вниз на плитах, валы смотрят вниз,
    ведущие шкивы — под плитами, на уровне венцов ведомых. Так вся стопка
    шкивов и рука опущены к основанию (Drive.BeltPlaneZ), а корпуса
    моторов торчат вверх, позади руки.
    """
    purge(doc, ("FR_",))
    part = container(doc, FRAME_PART, "Станина")

    S = V(d.PulleyAxisX.Value, d.ArmAxisY.Value, 0)
    Z0 = d.BeltPlaneZ.Value - d.FlangeThk.Value          # низ шкива 1
    M1 = V(0, 0, 0)
    M2 = V(d.Motor2X.Value, d.Motor2Y.Value, 0)
    face1, face2 = d.Motor1FaceZ.Value, d.Motor2FaceZ.Value
    fl = e.FloorZ.Value
    top = fl + e.BaseT.Value                               # верх основания
    wt = e.WallT.Value
    tA, tB = e.PlateAT.Value, e.PlateBT.Value
    zA0, zA1 = face1 - tA, face1                           # плита 1 под фланцем мотора 1
    zB0, zB1 = face2 - tB, face2
    gap = 4.0                                              # мотор <-> стенка (ход натяжения)
    xr1 = -NEMA_HALF - gap                                 # задняя стенка, внутр. грань
    xr0 = xr1 - wt
    yl1 = -NEMA_HALF - gap                                 # левая стенка
    yl0 = yl1 - wt
    yr0 = M2.y + NEMA_HALF + gap                           # правая стенка
    yr1 = yr0 + wt
    ymid = (M1.y + NEMA_HALF + M2.y - NEMA_HALF) / 2.0     # середина щели между моторами
    u1 = (S - M1); u1.normalize()                          # направление натяжения ремня 1
    u2 = (S - M2); u2.normalize()
    slot_h = e.TensionSlot.Value
    bush_lo = 2.5
    col_top = Z0 - bush_lo                                 # колонна вала: до нижней втулки
    # над плитами ходит глаз тяги: R57.5 от оси шкивов + 4 мм + ход натяжения
    rod_keep = 61.5 + slot_h

    # --- основание + стенки + колонна вала (одна печатная деталь) ---
    base = rounded_rect(e.BaseX0.Value, S.x + e.BaseFront.Value, e.BaseY0.Value, e.BaseY1.Value,
                        fl, top, 8.0)
    wall_rear_lo = box(xr0, xr1, yl0, ymid, top, zA0)
    wall_rear_hi = box(xr0, xr1, ymid, yr1, top, zB0)
    wall_left = box(xr0, NEMA_HALF + 5.0, yl0, yl1, top, zA0)
    wall_right = box(xr0, M2.x + NEMA_HALF, yr0, yr1, top, zB0)
    col_r = 12.0
    column = cyl(col_r, top, col_top, S.x, S.y)
    # ребро от левой стенки к колонне: под шкивом 1 и ремнём 1, ниже их
    pa, pb = V(18.0, yl0 + wt / 2.0, 0), V(S.x, S.y, 0)
    rl = (pb - pa).Length
    rib = box(0, rl, -3.0, 3.0, top, col_top)
    rib.rotate(V(0, 0, 0), V(0, 0, 1), math.degrees(math.atan2(pb.y - pa.y, pb.x - pa.x)))
    rib.translate(pa)
    frame = base.fuse([wall_rear_lo, wall_rear_hi, wall_left, wall_right, column, rib])

    # винты плит: по оси стенки, гайка в гнезде внутри стенки, паз — НАРУЖУ
    xw, ylw, yrw = xr0 + wt / 2.0, yl0 + wt / 2.0, yr0 + wt / 2.0
    padA = [(V(xw, ylw, 0), V(-1, 0, 0)), (V(xw, ymid - 10.0, 0), V(-1, 0, 0)),
            (V(12.0, ylw, 0), V(0, -1, 0))]
    padB = [(V(xw, ymid + 10.0, 0), V(-1, 0, 0)), (V(xw, yrw, 0), V(-1, 0, 0)),
            (V(10.0, yrw, 0), V(0, 1, 0))]
    L_plate = 16.0
    holes = []
    nuts_ = []
    for pads, ztop, t in ((padA, zA0, tA), (padB, zB0, tB)):
        for p, sl in pads:
            rot = 90.0 if sl.x else 0.0
            zn = ztop - (L_plate - t) + 1.5                 # конец винта на 1.5 ниже гайки
            holes.append(cyl(M3["hole"] / 2.0, ztop - (L_plate - t) - 2, ztop + 1, p.x, p.y))
            holes.append(nut_pocket(M3, zn, p.x, p.y, sl, rot=rot, depth=12))
            nuts_.append((p, zn, ztop + t, rot))
    # вал M8: болт сверху, гайка в гнезде колонны (паз открыт вперёд, +X).
    # Длина — самая короткая стандартная, при которой над гайкой остаётся
    # >= 4 мм пластика колонны: за этот «потолок» гайка тянет всю стопку
    zb_head = Z0 + d.BrgZ2.Value + d.BrgW2.Value + 4.0       # низ головки болта
    bolt_L = None
    for L in (40, 45, 50, 55, 60, 65, 70, 75, 80):
        zn = zb_head - L + 2.0
        if zn + M8["nut_m"] + 0.4 <= col_top - 4.0 and zb_head - L >= fl + 1.0:
            bolt_L = L
            break
    if bolt_L is None:
        raise RuntimeError("вал M8: колонна %.1f мм — гайка не помещается" % (col_top - top))
    z_nut = zb_head - bolt_L + 2.0
    holes.append(cyl(M8["hole"] / 2.0, z_nut - 4, col_top + 1, S.x, S.y))
    holes.append(nut_pocket(M8, z_nut, S.x, S.y, V(1, 0, 0), rot=90.0, depth=20))
    frame = frame.cut(holes).removeSplitter()
    frame = soften(frame, 1.5, (top,), "основание")
    feat(doc, part, "FR_Base", "Основание_станины", frame, PLA)

    # --- плиты моторов: мотор стоит на плите фланцем вниз, вал и ступица
    #     шкива проходят сквозь неё, буртик Ø22 — в выборке сверху.
    #     НАТЯЖЕНИЕ РЕМНЯ — сдвигом всей плиты с мотором вдоль ремня: пазы
    #     ±TensionSlot под винтами плиты к стенкам (их крутят сверху).
    #     Винты мотора к плите — простые отверстия: мотор крепят на столе
    #     до ремня. Под ближним к центру винтом мотора проходит ветвь
    #     ремня, на собранном роботе к нему не подлезть — поэтому
    #     натягивать сдвигом мотора по плите нельзя.
    def motor_plate(outline, z0, z1, M, u, pads, name):
        cuts = [cyl((NEMA_BOSS + 1.0) / 2.0, z1 - 2.5, z1 + 1, M.x, M.y),
                cyl(9.0, z0 - 1, z1 + 1, M.x, M.y)]
        for sx in (-1, 1):
            for sy in (-1, 1):
                cuts.append(cyl(M3["hole"] / 2.0, z0 - 1, z1 + 1,
                                M.x + sx * NEMA_PCD / 2, M.y + sy * NEMA_PCD / 2))
        for p, _ in pads:
            cuts.append(slot(M3["hole"] / 2.0, z0 - 1, z1 + 1, p, u, slot_h))
        return soften(outline, 1.0, (z1,), name).cut(cuts)

    plA = rounded_rect(xr0, NEMA_HALF + 5.0, yl0, ymid - 0.5, zA0, zA1, 4.0)
    plA = plA.cut(cyl(rod_keep, zA0 - 1, zA1 + 1, S.x, S.y))
    feat(doc, part, "FR_PlateA", "Плита_мотора_1",
         motor_plate(plA, zA0, zA1, M1, u1, padA, "плита 1"), PLA)
    xB1 = 22.0     # как у плиты 1: не ближе rod_keep к оси шкивов
    plB = rounded_rect(xr0, xB1, ymid + 0.5, yr1, zB0, zB1, 4.0)
    plB = plB.cut(cyl(rod_keep, zB0 - 1, zB1 + 1, S.x, S.y))
    feat(doc, part, "FR_PlateB", "Плита_мотора_2",
         motor_plate(plB, zB0, zB1, M2, u2, padB, "плита 2"), PLA)

    # --- крепёж плит и моторов ---
    i = 0
    for p, zn, zseat, rot in nuts_:
        i += 1
        o = feat(doc, part, "FR_PlScr%d" % i, "Винт_плиты_M3x%d_%d" % (L_plate, i),
                 cap_screw(M3, L_plate), DARK)
        o.Placement.Base = V(p.x, p.y, zseat)
        o = feat(doc, part, "FR_PlNut%d" % i, "Гайка_плиты_M3_%d" % i, nut(M3, rot), STEEL)
        o.Placement.Base = V(p.x, p.y, zn + 0.2)
    # винты моторов — СНИЗУ сквозь плиту в резьбу фланца (головка под плитой)
    down = App.Rotation(V(1, 0, 0), 180)
    for tag, M, zseat, L in (("A", M1, zA0, int(tA + 4)), ("B", M2, zB0, int(tB + 4))):
        for k, (sx, sy) in enumerate(((-1, -1), (-1, 1), (1, -1), (1, 1))):
            o = feat(doc, part, "FR_MotScr%s%d" % (tag, k + 1),
                     "Винт_мотора_%s_M3x%d_%d" % ("1" if tag == "A" else "2", L, k + 1),
                     cap_screw(M3, L), DARK)
            o.Placement = App.Placement(V(M.x + sx * NEMA_PCD / 2, M.y + sy * NEMA_PCD / 2, zseat),
                                        down)

    # --- вал: болт M8 сверху, втулки по внутренним кольцам, гайка в колонне ---
    feat(doc, part, "FR_ShaftBushLo", "Втулка_вала_нижняя_Ø12/Ø8.2x%.1f" % bush_lo,
         tube(6.0, 4.1, col_top, Z0, S.x, S.y), STEEL)
    zt = Z0 + d.BrgZ2.Value + d.BrgW2.Value
    feat(doc, part, "FR_ShaftBushHi", "Втулка_вала_верхняя_Ø12/Ø8.2x4",
         tube(6.0, 4.1, zt, zt + 4.0, S.x, S.y), STEEL)
    o = feat(doc, part, "FR_ShaftBolt", "Болт_вала_M8x%d_ISO4762" % bolt_L, cap_screw(M8, bolt_L), DARK)
    o.Placement.Base = V(S.x, S.y, zb_head)
    o = feat(doc, part, "FR_ShaftNut", "Гайка_вала_M8_ISO4032", nut(M8, 90.0), STEEL)
    o.Placement.Base = V(S.x, S.y, z_nut + 0.2)

    # --- ремни GT2: огибающая по делительным окружностям ---
    def belt(c1, r1, c2, r2, z0, w):
        def hull(dr):
            a = Part.makeCircle(r1 + dr, V(c1.x, c1.y, z0))
            b = Part.makeCircle(r2 + dr, V(c2.x, c2.y, z0))
            # внешние касательные двух окружностей
            dv = c2 - c1
            L = dv.Length
            ang = math.atan2(dv.y, dv.x)
            phi = math.acos(((r1 + dr) - (r2 + dr)) / L)
            pts = []
            n = 48
            for k in range(n + 1):     # дуга на c1
                t = ang + phi + (2 * math.pi - 2 * phi) * k / n
                pts.append(V(c1.x + (r1 + dr) * math.cos(t), c1.y + (r1 + dr) * math.sin(t), z0))
            for k in range(n + 1):     # дуга на c2
                t = ang - phi + 2 * phi * k / n
                pts.append(V(c2.x + (r2 + dr) * math.cos(t), c2.y + (r2 + dr) * math.sin(t), z0))
            pts.append(pts[0])
            return Part.Face(Part.makePolygon(pts)).extrude(V(0, 0, w))
        return hull(0.75).cut(hull(-0.63))
    pd1 = d.PitchD1.Value / 2.0
    zr1 = d.BeltPlaneZ.Value + (d.RimH.Value - d.BeltWidth.Value) / 2.0
    feat(doc, part, "FR_Belt1", "Ремень_GT2-%.0f_ступень_1" % d.BeltLength.Value,
         belt(S, d.PitchD2.Value / 2.0, M1, pd1, zr1, d.BeltWidth.Value), BELT)
    zr2 = Z0 + d.BeltPlaneZ2.Value + (d.RimH2.Value - d.BeltWidth2.Value) / 2.0
    feat(doc, part, "FR_Belt2", "Ремень_GT2-%.0f_ступень_2" % d.BeltLength2.Value,
         belt(S, d.PitchDriven2.Value / 2.0, M2, d.PitchDriver2.Value / 2.0, zr2,
              d.BeltWidth2.Value), BELT)
    doc.recompute()
    return part


# ---------------------------------------------------------------------------
# Рабочий узел
# ---------------------------------------------------------------------------
def build_effector(doc, d, e):
    purge(doc, ("EF_", "CR_"))
    tube_part = doc.getObject("Part_Tube")
    eff = container(doc, EFF_PART, "Рабочий_узел", tube_part)
    carr = container(doc, CARR_PART, "Каретка_Z", eff)
    eff.setExpression("Placement.Base.x", "%s.PivotX" % VS)
    eff.setExpression("Placement.Rotation.Angle", "%s.Tube2Angle" % VS)
    # грань магнита: высота над полем -> z в Part_Tube
    carr.setExpression("Placement.Base.z", "%s.FloorZ + %s.MagnetZ - (%s.BeltPlaneZ - %s.FlangeThk)"
                       % (VE, VE, VS, VS))

    tz = d.Tube2Z.Value               # ось трубы 2 во фрейме предплечья
    r_t = d.TubeOD.Value / 2.0
    hw = d.ElbowHalfW.Value
    bot = d.ElbowBot.Value
    capt = d.CapThk.Value
    sy = d.ElbowScrewY.Value
    zf_low = e.FloorZ.Value + 4.0 - (d.BeltPlaneZ.Value - d.FlangeThk.Value)   # грань магнита внизу
    rail_z0 = zf_low + SP_Z0                                               # низ ползуна внизу
    # высота оси шестерни Z: рейка в зацеплении на всём ходу (по 4 мм запаса)
    zp_lo = zf_low + Z_STROKE + SP_Z0 + 4.0
    zp_hi = zf_low + SP_Z1 - 4.0
    zp = (zp_lo + zp_hi) / 2.0
    r_zp = GEAR_M * ZP_TEETH / 2.0
    y_pitch = SP_HW + 2.0                      # делительная прямая рейки
    y_zp = y_pitch + r_zp                      # ось шестерни Z / SG90 №1

    # --- кронштейн: хомут на трубе 2 + пластина направляющей + фланец серво ---
    # рельс по высоте: снизу — где ползун при магните на поле, сверху — где
    # он при магните вверху. От высоты руки это не зависит: рука может
    # стоять низко, а каретка всё равно ходит от поля +4 до +38.6
    rail_z1 = max(tz + capt, zf_low + Z_STROKE + SP_Z1)
    clamp = box(CL_X0, GP_X1, -hw, hw, tz - bot, tz)
    plate = box(GP_X0, GP_X1, -GP_HW, GP_HW, rail_z0, rail_z1)
    ribs = []
    if rail_z0 + 8 < tz - bot:      # пластина ниже хомута: косынка снизу по оси
        ribs.append(Part.Face(Part.makePolygon(
            [V(CL_X0 + 6, -2, tz - bot), V(GP_X0, -2, tz - bot),
             V(GP_X0, -2, rail_z0 + 8), V(CL_X0 + 6, -2, tz - bot)])).extrude(V(0, 4, 0)))
    # боковые косынки за пластиной на всю её высоту — снаружи хомута (|y| > hw),
    # мимо винтов крышки и SG90 №1
    for y0 in (GP_HW - 4.0, -GP_HW):
        ribs.append(Part.Face(Part.makePolygon(
            [V(GP_X0 - 10, y0, tz - bot), V(GP_X0, y0, rail_z0 + 4), V(GP_X0, y0, rail_z1 - 4),
             V(GP_X0 - 10, y0, tz + capt), V(GP_X0 - 10, y0, tz - bot)])).extrude(V(0, 4, 0)))
    rib = ribs[0].fuse(ribs[1:]) if len(ribs) > 1 else ribs[0]
    # фланец SG90 №1: лапки ложатся на его заднюю грань x = SERVO_FLANGE_X
    sv_z0 = zp - SG_AXIS_Y                     # где у серво y_s = 0
    fl_y0, fl_y1 = GP_HW - 1.0, y_zp + 5.9 + 3.0
    fl_z0, fl_z1 = sv_z0 - 4.7 - 1.5, sv_z0 + 27.7 + 1.5
    flange = box(SERVO_FLANGE_X, GP_X1, fl_y0, fl_y1, fl_z0, fl_z1)
    win = box(SERVO_FLANGE_X - 1, GP_X1 + 1, y_zp - 5.9 - 0.3, y_zp + 5.9 + 0.3,
              sv_z0 - 0.3, sv_z0 + 22.5 + 0.3)
    rail = box(RAIL_NECK[0], RAIL_NECK[1], -RAIL_NECK[2], RAIL_NECK[2], rail_z0, rail_z1) \
        .fuse(box(RAIL_HEAD[0], RAIL_HEAD[1], -RAIL_HEAD[2], RAIL_HEAD[2], rail_z0, rail_z1))
    br = clamp.fuse([plate, rib, flange.cut(win), rail]).removeSplitter()
    cuts = [cyl_x(r_t, CL_X0 - 1, GP_X0, 0, tz)]
    for xs in CL_SCREW_X:
        for s_ in (1, -1):
            cuts.append(cyl(M3["hole"] / 2.0, tz - bot - 1, tz + 1, xs, s_ * sy))
            cuts.append(nut_pocket(M3, tz - bot, xs, s_ * sy, V(0, s_, 0), rot=0.0, depth=12))
    for ys in SG_HOLES_Y:       # отверстия под саморезы M2 лапок SG90 №1 (Ø1.6)
        cuts.append(cyl_x(0.8, SERVO_FLANGE_X - 1, GP_X1 + 1, y_zp, sv_z0 + ys))
    br = br.cut(cuts)
    feat(doc, eff, "EF_Bracket", "Кронштейн_Z", br, PLA2)
    capb = box(CL_X0, GP_X0, -hw, hw, tz, tz + capt).cut(cyl_x(r_t, CL_X0 - 1, GP_X0 + 1, 0, tz))
    for xs in CL_SCREW_X:
        for s_ in (1, -1):
            capb = capb.cut(cyl(M3["hole"] / 2.0, tz - 1, tz + capt + 1, xs, s_ * sy))
            capb = capb.cut(cyl(M3["dk"] / 2.0 + 0.25, tz + capt - d.CapWall.Value, tz + capt + 1,
                                xs, s_ * sy))
    feat(doc, eff, "EF_BracketCap", "Кронштейн_Z_крышка", capb, PLA2)
    k = 0
    for xs in CL_SCREW_X:
        for s_ in (1, -1):
            k += 1
            o = feat(doc, eff, "EF_ClScr%d" % k, "Винт_кронштейна_M3x16_%d" % k, cap_screw(M3, 16), DARK)
            o.Placement.Base = V(xs, s_ * sy, tz + capt - d.CapWall.Value)
            o = feat(doc, eff, "EF_ClNut%d" % k, "Гайка_кронштейна_M3_%d" % k, nut(M3, 0.0), STEEL)
            o.Placement.Base = V(xs, s_ * sy, tz - bot + 0.2)

    # --- SG90 №1: ось выхода вдоль +X, лапки на фланце ---
    s1 = sg90()
    # серво: z_s -> +X (лапки z_s 18.4 на x = SERVO_FLANGE_X), y_s -> +Z
    pl = App.Placement(V(SERVO_FLANGE_X - SG_TAB_Z1, y_zp, sv_z0),
                       App.Rotation(V(0, 1, 0), V(0, 0, 1), V(1, 0, 0), "ZXY"))
    o = feat(doc, eff, "EF_ServoZ", "Серво_Z_SG90", s1, SERVO)
    o.Placement = pl
    gx0 = SERVO_FLANGE_X - SG_TAB_Z1 + SG_GEAR_Z
    # шестерня Z: ось по X, при угле 0 зуб смотрит на рейку (-Y). Угол
    # поворота привязан к высоте магнита — шестерня катится по рейке, и
    # зубья в модели всегда в зацеплении, а не друг в друге.
    gz = involute_gear(GEAR_M, ZP_TEETH, GEAR_W, bore=4.9, plane="yz", phase=180.0)
    o = feat(doc, eff, "EF_GearZ", "Шестерня_Z_m1_z%d" % ZP_TEETH, gz, (0.95, 0.95, 0.95))
    o.Placement = App.Placement(V(gx0, y_zp, zp), App.Rotation(V(1, 0, 0), 0.001))
    z0f = d.BeltPlaneZ.Value - d.FlangeThk.Value
    o.setExpression("Placement.Rotation.Angle",
                    "(%.4f mm - %s.FloorZ - %s.MagnetZ) / %.4f mm * 180 deg / pi"
                    % (zp - SP_Z0 + z0f, VE, VE, r_zp))
    for j, ys in enumerate(SG_HOLES_Y):
        sc = cyl(1.0, -6.0, 0.0).fuse(cyl(2.0, 0.0, 1.4))      # саморез 2x6 из комплекта SG90
        sc.Placement = App.Placement(V(SERVO_FLANGE_X - SG_TAB_Z1 + SG_TAB_Z0, y_zp, sv_z0 + ys),
                                     App.Rotation(V(0, 1, 0), -90))
        feat(doc, eff, "EF_SvScrZ%d" % (j + 1), "Саморез_SG90_2x6_Z_%d" % (j + 1), sc, DARK)

    # --- каретка (всё дальше — в координатах «грань магнита = z 0») ---
    xs_ = SPINDLE_X
    spine = box(SP_X0, SP_X1, -SP_HW, SP_HW, SP_Z0, SP_Z1)
    slot_ = box(SP_X0 - 1, RAIL_NECK[1] + SLIDE_GAP / 2, -(RAIL_NECK[2] + SLIDE_GAP),
                RAIL_NECK[2] + SLIDE_GAP, SP_Z0 - 1, SP_Z1 + 1) \
        .fuse(box(RAIL_HEAD[0] - SLIDE_GAP, RAIL_HEAD[1] + SLIDE_GAP, -(RAIL_HEAD[2] + SLIDE_GAP),
                  RAIL_HEAD[2] + SLIDE_GAP, SP_Z0 - 1, SP_Z1 + 1))
    # рейка на +Y грани ползуна, ширина по X = под шестерню Z с запасом
    rk = rack(GEAR_M, SP_Z1 - SP_Z0, GEAR_W + 1.0, SP_Z0, 2.0)
    rk.translate(V(gx0 - 0.5, y_pitch, 0))
    hous = cyl(HOUS_R, HOUS_Z0, HOUS_Z1, xs_, 0)
    web = box(SP_X1 - 1, xs_, -10.0, 10.0, HOUS_Z0, HOUS_Z1)
    # SG90 №2: ось на (xs, -a), корпус вдоль +X, лапки на приливах
    a_w = GEAR_M * (SPG_TEETH + RTP_TEETH) / 2.0              # межосевое 19.5
    rt_y = -a_w
    sv2_z0 = HOUS_Z1 + 1.0 - SG_GEAR_Z                        # шестерня 2 на уровне шестерни шпинделя
    tab_z = sv2_z0 + SG_TAB_Z0
    # x вдоль корпуса: x = xs + (16.6 - y_s)
    xs_of = lambda ys: xs_ + (SG_AXIS_Y - ys)
    lug1 = box(xs_of(27.7) - 0.5, xs_of(22.5) + 0.0, rt_y - 5.9 - 0.5, -9.0, tab_z - 5.0, tab_z)
    lug2 = box(xs_of(0.0), xs_of(-4.7) + 0.5, rt_y - 5.9 - 0.5, rt_y + 5.9 + 0.5, tab_z - 5.0, tab_z)
    arm2 = box(xs_ + 4.0, xs_of(-4.7) + 0.5, rt_y + 5.9 + 0.3, -6.0, tab_z - 5.0, tab_z)
    web2 = box(SP_X1 - 1, xs_of(22.5), rt_y - 5.9 - 0.5, -9.0, HOUS_Z0, tab_z)
    car = spine.fuse([rk, hous, web, lug1, lug2, arm2, web2]).removeSplitter().cut(slot_)
    # гнёзда 624ZZ снизу и сверху, просвет между ними
    car = car.cut([cyl(BRG624["D"] / 2.0, HOUS_Z0 - 1, HOUS_Z0 + BRG624["B"], xs_, 0),
                   cyl(BRG624["D"] / 2.0, HOUS_Z1 - BRG624["B"], HOUS_Z1 + 1, xs_, 0),
                   cyl(3.75, HOUS_Z0, HOUS_Z1, xs_, 0)])
    for ys in SG_HOLES_Y:
        car = car.cut(cyl(0.8, tab_z - 6, tab_z + 1, xs_of(ys), rt_y))
    feat(doc, carr, "CR_Carriage", "Каретка_Z_ползун_шпиндель", car, PLA2)

    # подшипники и стопка внутренних колец шпинделя
    for nm, z0 in (("CR_Brg1", HOUS_Z0), ("CR_Brg2", HOUS_Z1 - BRG624["B"])):
        feat(doc, carr, nm, "Подшипник_шпинделя_624ZZ_%s" % nm[-1],
             tube(BRG624["D"] / 2.0, BRG624["d"] / 2.0, z0, z0 + BRG624["B"], xs_, 0), STEEL)
    feat(doc, carr, "CR_InnerSp", "Втулка_шпинделя_Ø6/Ø4.2x%.0f" % (HOUS_Z1 - HOUS_Z0 - 2 * BRG624["B"]),
         tube(3.0, 2.1, HOUS_Z0 + BRG624["B"], HOUS_Z1 - BRG624["B"], xs_, 0), STEEL)
    feat(doc, carr, "CR_Ext", "Удлинитель_магнита_Ø6/Ø4.2x%.0f" % EXT_H,
         tube(3.0, 2.1, MAG_H, MAG_H + EXT_H, xs_, 0), STEEL)
    mag = cyl(MAG_D / 2.0, 0.0, MAG_H, xs_, 0).cut(cyl(2.0, MAG_H - MAG_THREAD, MAG_H + 1, xs_, 0))
    feat(doc, carr, "CR_Magnet", "Электромагнит_KK-P20-15_12В", mag, (0.75, 0.15, 0.15))
    g_sp = involute_gear(GEAR_M, SPG_TEETH, GEAR_W, bore=4.3, shift=SPG_SHIFT, z0=HOUS_Z1 + 1.0)
    g_sp = g_sp.fuse(tube(3.0, 2.15, HOUS_Z1, HOUS_Z1 + 1.0)).removeSplitter()   # бобышка по внутр. кольцу
    g_sp.translate(V(xs_, 0, 0))
    feat(doc, carr, "CR_GearSp", "Шестерня_шпинделя_m1_z%d" % SPG_TEETH, g_sp, (0.95, 0.95, 0.95))
    zh = HOUS_Z1 + 1.0 + GEAR_W
    L4 = zh - (MAG_H - MAG_THREAD)
    o = feat(doc, carr, "CR_Screw", "Винт_шпинделя_M4x%.0f_ISO4762" % L4, cap_screw(M4, L4), DARK)
    o.Placement.Base = V(xs_, 0, zh)
    s2 = sg90()
    o = feat(doc, carr, "CR_ServoR", "Серво_поворота_SG90", s2, SERVO)
    # y_s -> -X (корпус уходит вперёд), x_s -> Y, z_s -> Z
    o.Placement = App.Placement(V(xs_ + SG_AXIS_Y, rt_y, sv2_z0),
                                App.Rotation(V(0, 0, 1), 90))
    g_rt = involute_gear(GEAR_M, RTP_TEETH, GEAR_W, bore=4.9, shift=RTP_SHIFT, z0=HOUS_Z1 + 1.0)
    g_rt.rotate(V(0, 0, 0), V(0, 0, 1), 90.0 % (360.0 / RTP_TEETH))   # зуб к шпинделю
    g_rt.translate(V(xs_, rt_y, 0))
    feat(doc, carr, "CR_GearRt", "Шестерня_поворота_m1_z%d" % RTP_TEETH, g_rt, (0.95, 0.95, 0.95))
    for j, ys in enumerate(SG_HOLES_Y):
        sc = cyl(1.0, -6.0, 0.0).fuse(cyl(2.0, 0.0, 1.4))
        sc.translate(V(xs_of(ys), rt_y, tab_z + 2.5))
        feat(doc, carr, "CR_SvScr%d" % (j + 1), "Саморез_SG90_2x6_пов_%d" % (j + 1), sc, DARK)
    doc.recompute()
    return eff, carr, dict(zp=zp, y_zp=y_zp, zf_low=zf_low, rail_z0=rail_z0)


# ---------------------------------------------------------------------------
# Полигон-ссылка (по ETZ_poligon.FCMacro и п. 2.1-2.2 ЕТЗ)
# ---------------------------------------------------------------------------
def poly_to_robot(d, e, px, py):
    return V(px - e.PolyShaftX.Value + d.PulleyAxisX.Value,
             py - e.PolyShaftY.Value + d.ArmAxisY.Value, e.FloorZ.Value)


def cell_centers():
    """Центры клеток и отбоя в координатах полигона: (имя, x, y)."""
    O_GX, O_GY = 370.0 + 193.0, (85.0 + (330.0 + 297.0) / 2.0) - 272.0   # метка id 27
    out = []
    for k, row in enumerate("АБВГДЕ"):
        for n in range(9):
            out.append(("%s%d" % (row, n), O_GX - 28.0 * (k + 1), O_GY + 28.0 * n))
    for k in range(1, 6):
        out.append(("Отбой%d" % k, O_GX - 28.0 * k, O_GY + 252.0))
    return out


def build_polygon(doc, d, e):
    purge(doc, ("PG_",))
    g = doc.getObject(POLY_GROUP)
    if g is None:
        g = doc.addObject("App::DocumentObjectGroup", POLY_GROUP)
    g.Label = "Полигон_ЕТЗ_ссылка"
    o0 = poly_to_robot(d, e, 0, 0)
    zones = [("PG_Zone1", "Зона_1_350x500", (0, 350, 0, 500), (0.92, 0.92, 0.92)),
             ("PG_Zone2a", "Зона_2_низ", (350, 600, 0, 80), (0.80, 0.80, 0.80)),
             ("PG_Zone2b", "Зона_2_верх", (350, 600, 420, 500), (0.80, 0.80, 0.80)),
             ("PG_Field", "Область_поля_250x330", (350, 600, 85, 415), (0.62, 0.62, 0.62))]
    for name, label, (x0, x1, y0, y1), col in zones:
        s = box(o0.x + x0, o0.x + x1, o0.y + y0, o0.y + y1, o0.z - 0.4, o0.z - 0.2)
        o = doc.addObject("Part::Feature", name)
        o.Shape = s
        o.Label = label
        g.addObject(o)
        if App.GuiUp:
            o.ViewObject.ShapeColor = col
    sheet = box(o0.x + 370, o0.x + 580, o0.y + 101.5, o0.y + 398.5, o0.z - 0.2, o0.z - 0.1)
    o = doc.addObject("Part::Feature", "PG_Sheet")
    o.Shape = sheet
    o.Label = "Лист_А4_поля"
    g.addObject(o)
    marks = []
    for nm, px, py in cell_centers():
        p = poly_to_robot(d, e, px, py)
        marks.append(Part.makeCylinder(3.0, 0.1, V(p.x, p.y, p.z - 0.1)))
    o = doc.addObject("Part::Feature", "PG_Cells")
    o.Shape = Part.makeCompound(marks)
    o.Label = "Центры_клеток_и_отбоя"
    g.addObject(o)
    if App.GuiUp:
        o.ViewObject.ShapeColor = (0.0, 0.0, 0.0)
    doc.recompute()
    return g


def main():
    doc = pick_doc()
    d = doc.getObject(VS)
    e = ensure_vs(doc)
    doc.recompute()
    build_frame(doc, d, e)
    eff, carr, info = build_effector(doc, d, e)
    build_polygon(doc, d, e)
    doc.recompute()
    print("станина, ремни, рабочий узел, полигон — построены")
    print("  ход Z %.1f мм за 180° SG90 (шестерня m1 z%d), магнит от поля +4 до +%.1f"
          % (Z_STROKE, ZP_TEETH, 4.0 + Z_STROKE))
    print("  поворот: z%d -> z%d, i = %.1f: 180° серво = %.0f° магнита"
          % (RTP_TEETH, SPG_TEETH, SPG_TEETH / float(RTP_TEETH), 180.0 * SPG_TEETH / RTP_TEETH))
    print("  вылет захвата от оси локтя %.1f мм" % SPINDLE_X)
    bad = [(o.Name, o.State) for o in doc.Objects if "Invalid" in o.State]
    if bad:
        print("  !! невалидные объекты:", bad)


if __name__ == "__main__":
    main()
