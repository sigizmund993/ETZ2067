def ensure_vs(doc):
    vs = doc.getObject(VE)
    if vs is None:
        vs = doc.addObject("App::VarSet", VE)
        vs.Label = "Etz"
    for name, typ, grp, default, tip in INPUTS:
        if not hasattr(vs, name):
            vs.addProperty(typ, name, grp, tip)
            setattr(vs, name, default)
    return vs


