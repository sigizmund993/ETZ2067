     "{V}.CenterDist - sqrt(max({V}.CenterDist2 ^ 2 - {V}.Motor2X ^ 2; 0 mm^2)"
     " / 1mm^2) * 1mm",
     "Y правого мотора: он отодвинут от общей оси шкивов на CenterDist2, "
     "а по X уже сдвинут на Motor2X, отсюда и Y. Требует "
     "CenterDist2 >= Motor2X"),
    ("Motor2Lift",   "App::PropertyLength", "6 Производные",
     "{V}.BeltPlaneZ2 - {V}.FlangeThk",
     "На сколько поднять правый мотор, чтобы его венец совпал с венцом "
     "второго ведомого шкива"),
    ("NutCircumR",       "App::PropertyLength", "6 Производные",
     "{V}.NutAF / sqrt(3)", "Радиус описанной окружности шестигранника"),
    ("NutZ",       "App::PropertyLength", "6 Производные",
     "{V}.PulleyH",
     "Низ паза гайки. Равен низу седла: паз открыт вниз, подошвы под гайкой "
     "нет (её не на чем печатать там, где седло свисает за фланец)"),
]


# ---------------------------------------------------------------------------
def pick_doc():
    act = App.ActiveDocument
    if act is not None and act.getObject(BODY_NAME) is not None:
        return act
    for d in App.listDocuments().values():
        if d.getObject(BODY_NAME) is not None:
            return d
    raise RuntimeError("не нашёл документ с телом " + BODY_NAME)


def ensure_varset(doc):
    """Создать VarSet или дополнить существующий, НЕ затирая значения пользователя."""
    vs = doc.getObject(VS_NAME)
    if vs is None:
        vs = doc.addObject("App::VarSet", VS_NAME)
        vs.Label = "Drive"
        created = True
    else:
        created = False

    for name, typ, grp, default, doc_str in INPUTS:
        if not hasattr(vs, name):
            vs.addProperty(typ, name, grp, doc_str)
            setattr(vs, name, default)

    for name, typ, grp, expr, doc_str in DERIVED:
        if not hasattr(vs, name):
            vs.addProperty(typ, name, grp, doc_str)
        # выражение переустанавливаем всегда — формула принадлежит макросу
        vs.setExpression(name, expr.format(V=VS_NAME))
    # пересчёт ОДИН раз в конце, а не после каждого выражения: на двух телах
    # со 120 зубьями полный пересчёт идёт минуты, и сорок пересчётов подряд
    # вешали FreeCAD наглухо. Порядок в DERIVED всё равно обязателен —
    # свойство должно существовать раньше ссылок на него, а значение для
    # setExpression не нужно.
    doc.recompute()
    return vs, created


def show_tip(body):
    """Сделать видимой только текущую Tip-фичу тела.

    Тело PartDesign рисует в 3D именно Tip, и видимость хранится у фичи,
    а не у тела. Если удалить фичу, которая была Tip (например
    забытое скругление), новая Tip остаётся невидимой — тело исчезает из
    вида, хотя Body.Visibility = True и форма на месте. Выглядит как
    «деталь пропала».
    """
    if not App.GuiUp:
        return
    for f in body.Group:
        f.ViewObject.Visibility = (f is body.Tip)


def setx(obj, prop, expr):
    obj.setExpression(prop, expr.format(V=VS_NAME))


def add(doc, body, kind, name, exprs=None, rot=None, **props):
    """Добавить примитив PartDesign в конец цепочки тела."""
    f = doc.addObject("PartDesign::" + kind, name)
    f.BaseFeature = body.Tip
    body.addObject(f)
    for k, v in props.items():
        setattr(f, k, v)
    if rot is not None:
        pl = f.Placement
        pl.Rotation = rot
        f.Placement = pl
    for k, v in (exprs or {}).items():
        setx(f, k, v)
    body.Tip = f
    return f


def wipe(doc, body):
    body.Tip = None
    for n in reversed([o.Name for o in list(body.Group)]):
        if doc.getObject(n) is not None:
            doc.removeObject(n)
    doc.recompute()


ROT_X = App.Rotation(App.Vector(0, 1, 0), 90)   # ось примитива Z -> глобальный X
ROT_Y = App.Rotation(App.Vector(1, 0, 0), -90)  # ось примитива Z -> глобальный Y


def purge_orphans(doc):
    """Снести фичи, оставшиеся без тела после прежних прогонов.

    Осиротевшие фичи PartDesign сцеплены через BaseFeature и в дереве
    показывают друг друга как детей, поэтому в RootObjects видно только
    хвост цепочки — снимать приходится слоями, пока не кончатся.
    """
    for _ in range(50):
        owned = set()
        for o in doc.Objects:
            if o.TypeId == "PartDesign::Body":
                owned.update(x.Name for x in o.Group)
        doomed = [o.Name for o in doc.Objects
                  if o.Name.startswith(("K_", "P_", "Q_", "S_", "T_",
                                                   "Rod_", "RdC_")) and o.Name not in owned]
        if not doomed:
            return
        for n in doomed:
            if doc.getObject(n) is not None:
                doc.removeObject(n)
        doc.recompute()


def build_pulley(doc, body):
    wipe(doc, body)
    zax = [o for o in body.Origin.OriginFeatures if o.Name.startswith("Z_Axis")][0]

    add(doc, body, "AdditiveCylinder", "P_Flange1",
        {"Radius": "{V}.FlangeD / 2", "Height": "{V}.FlangeThk"})
    add(doc, body, "AdditiveCylinder", "P_Rim",
        {"Radius": "{V}.TipD / 2", "Height": "{V}.RimH",
         "Placement.Base.z": "{V}.FlangeThk"})
    add(doc, body, "AdditiveCylinder", "P_Flange2",
        {"Radius": "{V}.FlangeD / 2", "Height": "{V}.FlangeThk",
         "Placement.Base.z": "{V}.FlangeThk + {V}.RimH"})

    # --- окна облегчения (как в референсе: 3 выреза между спицами) ---
    # сектор режется насквозь, затем ступица возвращается сплошным диском;
    # фаза подобрана так, чтобы спица всегда приходилась под седло руки
    win = add(doc, body, "SubtractiveCylinder", "P_Window",
              {"Radius": "{V}.WindowRout", "Height": "{V}.PulleyH + 2 mm",
               "Angle": "{V}.WindowAngle",
               "Placement.Base.z": "-1 mm",
               "Placement.Rotation.Angle": "{V}.WindowPhase"},
              rot=App.Rotation(App.Vector(0, 0, 1), 1))
    wpat = doc.addObject("PartDesign::PolarPattern", "P_Windows")
    wpat.BaseFeature = body.Tip
    body.addObject(wpat)
    wpat.Originals = [win]
    wpat.Axis = (zax, [""])
    wpat.Angle = 360.0
    wpat.Mode = "Extent"
    body.Tip = wpat
    setx(wpat, "Occurrences", "{V}.WindowCount")
    add(doc, body, "AdditiveCylinder", "P_Hub",
        {"Radius": "{V}.WindowRin", "Height": "{V}.PulleyH"})

    # --- седло под трубу (до сверловок, чтобы отверстия прошли и через него) ---
    add(doc, body, "AdditiveBox", "P_Saddle",
        {"Length": "{V}.ClampLen", "Width": "2 * {V}.SaddleHalfW",
         "Height": "{V}.SaddleH",
         "Placement.Base.x": "{V}.ClampStartR",
         "Placement.Base.y": "-{V}.SaddleHalfW",
         "Placement.Base.z": "{V}.PulleyH"})
    # полукруглый жёлоб: цилиндр по оси X + вырез всего, что над ним
    add(doc, body, "SubtractiveCylinder", "P_TubeGroove",
        {"Radius": "{V}.TubeOD / 2", "Height": "{V}.ClampLen + 20 mm",
         "Placement.Base.x": "{V}.ClampStartR - 10 mm",
         "Placement.Base.z": "{V}.TubeAxisZ"}, rot=ROT_X)
    add(doc, body, "SubtractiveBox", "P_TubeOpen",
        {"Length": "{V}.ClampLen + 20 mm", "Width": "{V}.TubeOD", "Height": "20 mm",
         "Placement.Base.x": "{V}.ClampStartR - 10 mm",
         "Placement.Base.y": "-{V}.TubeOD / 2",
         "Placement.Base.z": "{V}.TubeAxisZ"})

    # --- зубья ---
    groove = add(doc, body, "SubtractiveCylinder", "P_Groove",
                 {"Radius": "{V}.ToothR", "Height": "{V}.RimH",
                  "Placement.Base.x": "{V}.PitchD2 / 2 - {V}.ToothOffset",
                  "Placement.Base.z": "{V}.FlangeThk"})
    pat = doc.addObject("PartDesign::PolarPattern", "P_Teeth")
    pat.BaseFeature = body.Tip
    body.addObject(pat)
    pat.Originals = [groove]
    pat.Axis = (zax, [""])
    pat.Angle = 360.0
    pat.Mode = "Extent"
    body.Tip = pat
    setx(pat, "Occurrences", "{V}.DrivenTeeth")

    # --- отверстия ---
    add(doc, body, "SubtractiveCylinder", "P_Bore",
        {"Radius": "{V}.ShaftHoleD / 2", "Height": "{V}.PulleyH + 2 mm",
         "Placement.Base.z": "-1 mm"})
    add(doc, body, "SubtractiveCylinder", "P_Seat",
        {"Radius": "{V}.BrgOD / 2", "Height": "{V}.BrgW"})

    # --- крепёж хомута: сквозное отверстие сверху + паз под гайку M3 ---
    # винт идёт с крышки вниз и затягивается в гайку, лежащую в пазу седла.
    # Гайка заводится сбоку, тянущее усилие держит потолок паза (5+ мм),
    # пол паза нужен только чтобы гайка не выпала.
    for i, (sx, sy) in enumerate([("ScrewX1", "+"), ("ScrewX1", "-"),
                                  ("ScrewX2", "+"), ("ScrewX2", "-")]):
        plus = (sy == "+")
        ey = ("" if plus else "-") + "{V}.ScrewY"
        # ближняя к центру пара сверлится насквозь через весь шкив: винт
        # может выходить за гайку, длина винта перестаёт быть критичной.
        # Дальняя пара висит за фланцем, сверлить там нечего.
        skvoz = (sx == "ScrewX1")
        z0 = "-1 mm" if skvoz else "{V}.PulleyH - 2 mm"
        hh = ("{V}.TubeAxisZ + 2 mm" if skvoz
              else "{V}.TubeAxisZ - {V}.PulleyH + 2 mm")
        add(doc, body, "SubtractiveCylinder", "P_Screw%d" % (i + 1),
            {"Radius": "({V}.ScrewM + 0.4 mm) / 2",
             "Height": hh,
             "Placement.Base.x": "{V}." + sx,
             "Placement.Base.y": ey,
             "Placement.Base.z": z0})
        add(doc, body, "SubtractivePrism", "P_Nut%d" % (i + 1),
            {"Circumradius": "{V}.NutCircumR", "Height": "{V}.NutThk",
             "Placement.Base.x": "{V}." + sx,
             "Placement.Base.y": ey,
             "Placement.Base.z": "{V}.NutZ"},
            rot=App.Rotation(App.Vector(0, 0, 1), 30), Polygon=6)
        ybase = ("{V}.ScrewY" if plus else "-({V}.SaddleHalfW + 1 mm)")
        add(doc, body, "SubtractiveBox", "P_NutSlot%d" % (i + 1),
            {"Length": "{V}.NutAF",
             "Width": "{V}.SaddleHalfW + 1 mm - {V}.ScrewY",
             "Height": "{V}.NutThk",
             "Placement.Base.x": "{V}." + sx + " - {V}.NutAF / 2",
             "Placement.Base.y": ybase,
             "Placement.Base.z": "{V}.NutZ"})

    body.Label = PULLEY_LABEL
    doc.recompute()
    show_tip(body)
    return body


def build_cap(doc, part):
    old = doc.getObject(CAP_NAME)
    if old is not None:
        # removeObject на теле НЕ удаляет его фичи — они осиротеют в корне
        # документа. Сначала вычищаем содержимое, только потом само тело.
        wipe(doc, old)
        doc.removeObject(old.Name)
        doc.recompute()
    purge_orphans(doc)
    body = doc.addObject("PartDesign::Body", CAP_NAME)
    part.addObject(body)
    body.Label = CAP_LABEL

    add(doc, body, "AdditiveBox", "K_Body",
        {"Length": "{V}.ClampLen", "Width": "2 * {V}.SaddleHalfW",
         "Height": "{V}.CapThk",
         "Placement.Base.x": "{V}.ClampStartR",
         "Placement.Base.y": "-{V}.SaddleHalfW",
         "Placement.Base.z": "{V}.TubeAxisZ"})
    add(doc, body, "SubtractiveCylinder", "K_Groove",
        {"Radius": "{V}.TubeOD / 2", "Height": "{V}.ClampLen + 20 mm",
         "Placement.Base.x": "{V}.ClampStartR - 10 mm",
         "Placement.Base.z": "{V}.TubeAxisZ"}, rot=ROT_X)
    for i, (sx, sy) in enumerate([("ScrewX1", "+"), ("ScrewX1", "-"),
                                  ("ScrewX2", "+"), ("ScrewX2", "-")]):
        s = ("" if sy == "+" else "-") + "{V}.ScrewY"
        add(doc, body, "SubtractiveCylinder", "K_Hole%d" % (i + 1),
            {"Radius": "({V}.ScrewM + 0.4 mm) / 2", "Height": "{V}.CapThk + 2 mm",
             "Placement.Base.x": "{V}." + sx, "Placement.Base.y": s,
             "Placement.Base.z": "{V}.TubeAxisZ - 1 mm"})
        add(doc, body, "SubtractiveCylinder", "K_Cbore%d" % (i + 1),
            {"Radius": "{V}.ScrewM", "Height": "{V}.CapWall",
             "Placement.Base.x": "{V}." + sx, "Placement.Base.y": s,
             "Placement.Base.z": "{V}.TubeAxisZ + {V}.CapThk - {V}.CapWall"})
    doc.recompute()
    show_tip(body)
    return body


def build_pulley2(doc, part):
    """Второй ведомый шкив: та же передача, без хомута, с рычагом.

    Сидит на проставке над первым шкивом. Венец и диаметры считаются из
    тех же переменных, что у первого, то есть передача совпадает
    автоматически. Рычаг висит ПОД нижним фланцем: внутри фланцев идёт
    ремень, туда лезть нельзя, а снизу свободно.

    Ядро (фланцы/венец/окна/зубья) повторяет build_pulley — специально
    отдельным кодом с префиксом Q_, чтобы правки здесь не трогали
    работающую цепочку первого шкива.
    """
    old = doc.getObject(PUL2_NAME)
    if old is not None:
        wipe(doc, old)
        doc.removeObject(old.Name)
        doc.recompute()
    purge_orphans(doc)
    body = doc.addObject("PartDesign::Body", PUL2_NAME)
    part.addObject(body)
    body.Label = PUL2_LABEL
    zax = [o for o in body.Origin.OriginFeatures if o.Name.startswith("Z_Axis")][0]

    # --- рычаг: утолщение нижнего фланца, верх заподлицо с его верхом ---
    # Верхняя грань рычага = верхняя грань фланца, рост идёт вниз. Внутри
    # фланцев проходит ремень, а под фланцем свободно, поэтому толщину
    # рычага можно менять не оглядываясь на ремень. До центра рычаг не
    # доходит (начинается с LeverR0): снизу в ступицу заходит подшипник.
    add(doc, body, "AdditiveBox", "Q_LeverBar",
        {"Length": "{V}.LeverLen - {V}.LeverR0",
         "Width": "{V}.LeverWidth", "Height": "{V}.LeverThk",
         "Placement.Base.x": "{V}.LeverR0",
         "Placement.Base.y": "-{V}.LeverWidth / 2",
         "Placement.Base.z": "{V}.LeverZ"})
    add(doc, body, "AdditiveCylinder", "Q_LeverTip",
        {"Radius": "{V}.LeverWidth / 2", "Height": "{V}.LeverThk",
         "Placement.Base.x": "{V}.LeverLen",
         "Placement.Base.z": "{V}.LeverZ"})

    # --- шкив: те же выражения, что у первого, только со смещением по z ---
    add(doc, body, "AdditiveCylinder", "Q_Flange1",
        {"Radius": "{V}.FlangeD2 / 2", "Height": "{V}.FlangeThk2",
         "Placement.Base.z": "{V}.Pulley2Z"})
    add(doc, body, "AdditiveCylinder", "Q_Rim",
        {"Radius": "{V}.TipD2 / 2", "Height": "{V}.RimH2",
         "Placement.Base.z": "{V}.Pulley2Z + {V}.FlangeThk2"})
    add(doc, body, "AdditiveCylinder", "Q_Flange2",
        {"Radius": "{V}.FlangeD2 / 2", "Height": "{V}.FlangeThk2",
         "Placement.Base.z": "{V}.Pulley2Z + {V}.FlangeThk2 + {V}.RimH2"})

    win = add(doc, body, "SubtractiveCylinder", "Q_Window",
              {"Radius": "{V}.WindowRout2", "Height": "{V}.PulleyH2 + 2 mm",
               "Angle": "{V}.WindowAngle2",
               "Placement.Base.z": "{V}.Pulley2Z - 1 mm",
               "Placement.Rotation.Angle": "{V}.WindowPhase2"},
              rot=App.Rotation(App.Vector(0, 0, 1), 1))
    wpat = doc.addObject("PartDesign::PolarPattern", "Q_Windows")
    wpat.BaseFeature = body.Tip
    body.addObject(wpat)
    wpat.Originals = [win]
    wpat.Axis = (zax, [""])
    wpat.Angle = 360.0
    wpat.Mode = "Extent"
    body.Tip = wpat
    setx(wpat, "Occurrences", "{V}.WindowCount2")

    add(doc, body, "AdditiveCylinder", "Q_Hub",
        {"Radius": "{V}.WindowRin2", "Height": "{V}.PulleyH2",
         "Placement.Base.z": "{V}.Pulley2Z"})

    groove = add(doc, body, "SubtractiveCylinder", "Q_Groove",
                 {"Radius": "{V}.ToothR", "Height": "{V}.RimH2",
                  "Placement.Base.x": "{V}.PitchDriven2 / 2 - {V}.ToothOffset",
                  "Placement.Base.z": "{V}.Pulley2Z + {V}.FlangeThk2"})
    pat = doc.addObject("PartDesign::PolarPattern", "Q_Teeth")
    pat.BaseFeature = body.Tip
    body.addObject(pat)
    pat.Originals = [groove]
    pat.Axis = (zax, [""])
    pat.Angle = 360.0
    pat.Mode = "Extent"
    body.Tip = pat
    setx(pat, "Occurrences", "{V}.DrivenTeeth2")

    # --- отверстия: ось насквозь через шкив и рычаг, плюс глаз рычага ---
    add(doc, body, "SubtractiveCylinder", "Q_Bore",
        {"Radius": "{V}.ShaftHoleD2 / 2",
         "Height": "{V}.Pulley2Z + {V}.PulleyH2 - {V}.LeverZ + 2 mm",
         "Placement.Base.z": "{V}.LeverZ - 1 mm"})
    # гнездо подшипника открыто ВНИЗ, как у первого шкива; сверху от него
    # остаётся упор толщиной PulleyH - BrgW с отверстием ShaftHoleD
    add(doc, body, "SubtractiveCylinder", "Q_Seat2",
        {"Radius": "{V}.BrgOD2 / 2", "Height": "{V}.BrgW2 + 1 mm",
         "Placement.Base.z": "{V}.BrgZ2 - 1 mm"})
    add(doc, body, "SubtractiveCylinder", "Q_LeverHole",
        {"Radius": "{V}.LeverHoleD / 2", "Height": "{V}.LeverThk + 2 mm",
         "Placement.Base.x": "{V}.LeverLen",
         "Placement.Base.z": "{V}.LeverZ - 1 mm"})

    # рычаг смотрит вдоль +X; направление задаётся поворотом всего тела,
    # поэтому спица окна остаётся ровно под рычагом
    setx(body, "Placement.Rotation.Angle", "{V}.LeverAngle")
    doc.recompute()
    show_tip(body)
    return body


def build_tube(doc):
    """Труба руки — ОТДЕЛЬНЫЙ парт, вставляется в хомут первого шкива.

    Свой контейнер App::Part, чтобы трубу можно было двигать и считать
    отдельной деталью. Его Placement привязан к тем же переменным, что и
    у привода, поэтому труба едет вместе с узлом: по Y на межосевое, по
    Z на плоскость венца.
    """
    old = doc.getObject(TUBE_BODY)
    if old is not None:
        wipe(doc, old)
        doc.removeObject(old.Name)
        doc.recompute()
    purge_orphans(doc)
    part = doc.getObject(TUBE_PART)
    if part is None:
        part = doc.addObject("App::Part", TUBE_PART)
        part.Label = TUBE_PLABEL
    body = doc.addObject("PartDesign::Body", TUBE_BODY)
    part.addObject(body)
    body.Label = TUBE_BLABEL

    add(doc, body, "AdditiveCylinder", "T_Tube",
        {"Radius": "{V}.TubeOD / 2", "Height": "{V}.TubeLen",
         "Placement.Base.x": "{V}.ClampStartR",
         "Placement.Base.z": "{V}.TubeAxisZ"}, rot=ROT_X)
    add(doc, body, "SubtractiveCylinder", "T_Bore",
        {"Radius": "{V}.TubeOD / 2 - {V}.TubeWall",
         "Height": "{V}.TubeLen + 2 mm",
         "Placement.Base.x": "{V}.ClampStartR - 1 mm",
         "Placement.Base.z": "{V}.TubeAxisZ"}, rot=ROT_X)

    setx(part, "Placement.Base.y", "{V}.CenterDist")
    setx(part, "Placement.Base.z", "{V}.BeltPlaneZ - {V}.FlangeThk")
    doc.recompute()
    show_tip(body)
    return body


def _clamp_screws(doc, body, xs, zbot, through_h, pfx=None):
    """Вертикальные отверстия M3 и пазы под гайки — схема как на шкиве 1.

    Винт идёт сверху через зенковку в крышке и затягивается в гайку,
    лежащую в пазу на нижней грани хомута. Паз открыт вбок, гайка
    заводится сбоку, тянущее усилие держит его потолок.
    """
    pfx = pfx or body.Name[5:8]
    for i, xe in enumerate(xs):
        for sy in ("+", "-"):
            ey = ("" if sy == "+" else "-") + "{V}.ElbowScrewY"
            tag = "%d%s" % (i + 1, "p" if sy == "+" else "m")
            add(doc, body, "SubtractiveCylinder", "%s_Scr%s" % (pfx, tag),
                {"Radius": "({V}.ScrewM + 0.4 mm) / 2", "Height": through_h,
                 "Placement.Base.x": xe, "Placement.Base.y": ey,
                 "Placement.Base.z": zbot + " - 1 mm"})
            add(doc, body, "SubtractivePrism", "%s_Nut%s" % (pfx, tag),
                {"Circumradius": "{V}.NutCircumR", "Height": "{V}.NutThk",
                 "Placement.Base.x": xe, "Placement.Base.y": ey,
                 "Placement.Base.z": zbot},
                rot=App.Rotation(App.Vector(0, 0, 1), 30), Polygon=6)
            ybase = (ey if sy == "+" else "-({V}.ElbowHalfW + 1 mm)")
            add(doc, body, "SubtractiveBox", "%s_Slot%s" % (pfx, tag),
                {"Length": "{V}.NutAF",
                 "Width": "{V}.ElbowHalfW + 1 mm - {V}.ElbowScrewY",
                 "Height": "{V}.NutThk",
                 "Placement.Base.x": xe + " - {V}.NutAF / 2",
                 "Placement.Base.y": ybase,
                 "Placement.Base.z": zbot})


def _clamp_cap(doc, part, name, label, x0, length, like, pfx=None):
    """Прижимная крышка хомута: половина жёлоба сверху плюс зенковки."""
    old = doc.getObject(name)
    if old is not None:
        wipe(doc, old)
        doc.removeObject(old.Name)
        doc.recompute()
    purge_orphans(doc)
    body = doc.addObject("PartDesign::Body", name)
    part.addObject(body)
    body.Label = label
    pfx = pfx or name[5:8]
    add(doc, body, "AdditiveBox", "%s_Body" % pfx,
        {"Length": length, "Width": "2 * {V}.ElbowHalfW", "Height": "{V}.CapThk",
         "Placement.Base.x": x0, "Placement.Base.y": "-{V}.ElbowHalfW"})
    add(doc, body, "SubtractiveCylinder", "%s_Groove" % pfx,
        {"Radius": "{V}.TubeOD / 2", "Height": length + " + 2 mm",
         "Placement.Base.x": x0 + " - 1 mm"}, rot=ROT_X)
    for i, xe in enumerate(like):
        for sy in ("+", "-"):
            ey = ("" if sy == "+" else "-") + "{V}.ElbowScrewY"
            tag = "%d%s" % (i + 1, "p" if sy == "+" else "m")
            add(doc, body, "SubtractiveCylinder", "%s_H%s" % (pfx, tag),
                {"Radius": "({V}.ScrewM + 0.4 mm) / 2", "Height": "{V}.CapThk + 2 mm",
                 "Placement.Base.x": xe, "Placement.Base.y": ey,
                 "Placement.Base.z": "-1 mm"})
            add(doc, body, "SubtractiveCylinder", "%s_C%s" % (pfx, tag),
                {"Radius": "{V}.ScrewM", "Height": "{V}.CapWall",
                 "Placement.Base.x": xe, "Placement.Base.y": ey,
                 "Placement.Base.z": "{V}.CapThk - {V}.CapWall"})
    doc.recompute()
    show_tip(body)
    return body


def build_elbow(doc, part):
    """Локоть: шарнир на подшипнике между первой и второй трубой.

    Два хомута, каждый на винтах M3 по той же схеме, что хомут на шкиве.
    Хомут 1 сидит на торце первой трубы и несёт проушину, хомут 2 держит
    вторую трубу (она проходит его насквозь) и вращается на подшипнике.

    Локальные координаты обоих тел: начало — ОСЬ ШАРНИРА, труба идёт по
    локальному X, её ось на локальном z = 0. Поэтому хомут 2 вместе с
    крышкой и трубой поворачивается простым Placement.Rotation вокруг Z —
    он же проходит ровно через ось шарнира.

    Вторая труба начинается с Tube2X0 ОТ ОСИ ШАРНИРА. Звено мерится до
    ОСИ ПАЛЬЦА ТЯГИ, а она стоит на LeverLen — ровно длина рычага на
    втором шкиве, это и есть условие параллелограмма. Сама труба
    кончается на JointReach раньше пальца: дальше её продолжает планка
    проушины шарнира тяги (см. build_rod_joint).
    """
    for name in (ELBOW_NAME, ELBCAP_NAME, ELBOW2_NAME, ELB2CAP_NAME, TUBE2_NAME):
        old = doc.getObject(name)
        if old is not None:
            wipe(doc, old)
            doc.removeObject(old.Name)
            doc.recompute()
    purge_orphans(doc)

    # ---------- хомут 1: на торце первой трубы, с проушиной ----------
    a = doc.addObject("PartDesign::Body", ELBOW_NAME)
    part.addObject(a)
    a.Label = ELBOW_LABEL
    add(doc, a, "AdditiveBox", "Elb_Block",
        {"Length": "{V}.ElbowEndX + {V}.ElbowGrip", "Width": "2 * {V}.ElbowHalfW",
         "Height": "{V}.ElbowBot",
         "Placement.Base.x": "-({V}.ElbowEndX + {V}.ElbowGrip)",
         "Placement.Base.y": "-{V}.ElbowHalfW",
         "Placement.Base.z": "-{V}.ElbowBot"})
    add(doc, a, "AdditiveCylinder", "Elb_Lug",
        {"Radius": "{V}.PivotLugR", "Height": "{V}.ElbowBot",
         "Placement.Base.z": "-{V}.ElbowBot"})
    add(doc, a, "SubtractiveCylinder", "Elb_Groove",
        {"Radius": "{V}.TubeOD / 2", "Height": "{V}.ElbowGrip + 1 mm",
         "Placement.Base.x": "-({V}.ElbowEndX + {V}.ElbowGrip) - 1 mm"}, rot=ROT_X)
    add(doc, a, "SubtractiveCylinder", "Elb_Pivot",
        {"Radius": "({V}.ScrewM + 0.4 mm) / 2", "Height": "{V}.ElbowBot + 2 mm",
         "Placement.Base.z": "-{V}.ElbowBot - 1 mm"})
    add(doc, a, "SubtractivePrism", "Elb_PivotNut",
        {"Circumradius": "{V}.NutCircumR", "Height": "{V}.NutThk",
         "Placement.Base.z": "-{V}.ElbowBot"},
        rot=App.Rotation(App.Vector(0, 0, 1), 30), Polygon=6)
    add(doc, a, "SubtractiveBox", "Elb_PivotSlot",
        {"Length": "{V}.NutAF", "Width": "{V}.ElbowHalfW + 1 mm",
         "Height": "{V}.NutThk",
         "Placement.Base.x": "-{V}.NutAF / 2",
         "Placement.Base.z": "-{V}.ElbowBot"})
    _clamp_screws(doc, a, ["-{V}.ElbowScrewX1", "-{V}.ElbowScrewX2"],
                  "-{V}.ElbowBot", "{V}.ElbowBot + 2 mm")
    setx(a, "Placement.Base.x", "{V}.PivotX")
    setx(a, "Placement.Base.z", "{V}.TubeAxisZ")
    doc.recompute()
    show_tip(a)

    acap = _clamp_cap(doc, part, ELBCAP_NAME, ELBCAP_LABEL,
                      "-({V}.ElbowEndX + {V}.ElbowGrip)", "{V}.ElbowGrip",
                      ["-{V}.ElbowScrewX1", "-{V}.ElbowScrewX2"])
    setx(acap, "Placement.Base.x", "{V}.PivotX")
    setx(acap, "Placement.Base.z", "{V}.TubeAxisZ")

    # ---------- хомут 2: на второй трубе, вращается на подшипнике ----------
    b = doc.addObject("PartDesign::Body", ELBOW2_NAME)
    part.addObject(b)
    b.Label = ELBOW2_LABEL
    add(doc, b, "AdditiveBox", "Elb2_Block",
        {"Length": "{V}.ElbowGrip", "Width": "2 * {V}.ElbowHalfW",
         "Height": "{V}.ElbowBot",
         "Placement.Base.x": "-{V}.ElbowGrip / 2",
         "Placement.Base.y": "-{V}.ElbowHalfW",
         "Placement.Base.z": "-{V}.ElbowBot"})
    add(doc, b, "AdditiveCylinder", "Elb2_Lug",
        {"Radius": "{V}.PivotLugR", "Height": "{V}.Elbow2Bot",
         "Placement.Base.z": "-{V}.Elbow2Bot"})
    add(doc, b, "SubtractiveCylinder", "Elb2_Groove",
        {"Radius": "{V}.TubeOD / 2", "Height": "{V}.ElbowGrip + 2 mm",
         "Placement.Base.x": "-{V}.ElbowGrip / 2 - 1 mm"}, rot=ROT_X)
    add(doc, b, "SubtractiveCylinder", "Elb2_Seat",
        {"Radius": "{V}.PivotBrgOD / 2", "Height": "{V}.PivotBrgW",
         "Placement.Base.z": "-{V}.Elbow2Bot"})
    add(doc, b, "SubtractiveCylinder", "Elb2_HeadC",
        {"Radius": "{V}.ScrewM", "Height": "{V}.PivotHeadC",
         "Placement.Base.z": "-{V}.Elbow2Bot + {V}.PivotBrgW"})
    _clamp_screws(doc, b, ["{V}.Elbow2ScrewX", "-{V}.Elbow2ScrewX"],
                  "-{V}.ElbowBot", "{V}.ElbowBot + 2 mm")
    setx(b, "Placement.Base.x", "{V}.PivotX")
    setx(b, "Placement.Base.z", "{V}.Tube2Z")
    setx(b, "Placement.Rotation.Angle", "{V}.Tube2Angle")
    doc.recompute()
    show_tip(b)

    bcap = _clamp_cap(doc, part, ELB2CAP_NAME, ELB2CAP_LABEL,
                      "-{V}.ElbowGrip / 2", "{V}.ElbowGrip",
                      ["{V}.Elbow2ScrewX", "-{V}.Elbow2ScrewX"])
    setx(bcap, "Placement.Base.x", "{V}.PivotX")
    setx(bcap, "Placement.Base.z", "{V}.Tube2Z")
    setx(bcap, "Placement.Rotation.Angle", "{V}.Tube2Angle")

    # ---------- вторая труба, в том же локальном фрейме что хомут 2 ----------
    t2 = doc.addObject("PartDesign::Body", TUBE2_NAME)
    part.addObject(t2)
    t2.Label = TUBE2_LABEL
    add(doc, t2, "AdditiveCylinder", "U_Tube",
        {"Radius": "{V}.TubeOD / 2", "Height": "{V}.Tube2Full",
         "Placement.Base.x": "{V}.Tube2X0"}, rot=ROT_X)
    add(doc, t2, "SubtractiveCylinder", "U_Bore",
        {"Radius": "{V}.TubeOD / 2 - {V}.TubeWall",
         "Height": "{V}.Tube2Full + 2 mm",
         "Placement.Base.x": "{V}.Tube2X0 - 1 mm"}, rot=ROT_X)
    setx(t2, "Placement.Base.x", "{V}.PivotX")
    setx(t2, "Placement.Base.z", "{V}.Tube2Z")
    setx(t2, "Placement.Rotation.Angle", "{V}.Tube2Angle")
    doc.recompute()
    show_tip(t2)
    return a, acap, b, bcap, t2


def build_rod_joint(doc, part):
    """Шарнир тяги на свободном конце второй трубы.

    Проушина лежит РОВНО в полосе рычага второго шкива
    (z LeverZ..LeverZ + LeverThk), поэтому тяга между ними — плоская
    планка с двумя отверстиями Ø LeverHoleD, а не Z-образная.

    Ось пальца стоит на LeverLen от оси шарнира локтя: вылет предплечья
    равен рычагу — это и есть условие параллелограмма. Поэтому труба 2
    кончается на JointReach раньше пальца, а пролёт до него закрывает
    планка проушины; иначе планку пришлось бы вести внутри трубы.

    Хомут садится на конец трубы как остальные: низ + крышка на винтах
    M3 с гайками в пазах. Торцевая стенка JointWall заглушает его с
    конца — в неё планка и входит, поэтому стык объёмный, а не по
    касательной.

    Локальный фрейм тот же, что у хомута 2 и трубы 2: начало — ось
    шарнира локтя, труба по локальному X, её ось на z = 0. Значит хомут
    поворачивается вместе с предплечьем (Tube2Angle).
    """
    old = doc.getObject(JOINT_NAME)
    if old is not None:
        wipe(doc, old)
        doc.removeObject(old.Name)
        doc.recompute()
    purge_orphans(doc)
    j = doc.addObject("PartDesign::Body", JOINT_NAME)
    part.addObject(j)
    j.Label = JOINT_LABEL
    xs = ["{V}.JointMidX + {V}.JointScrewX", "{V}.JointMidX - {V}.JointScrewX"]

    add(doc, j, "AdditiveBox", "Rod_Block",
        {"Length": "{V}.JointGrip + {V}.JointWall",
         "Width": "2 * {V}.ElbowHalfW", "Height": "{V}.ElbowBot",
         "Placement.Base.x": "{V}.Tube2X0 - {V}.JointWall",
         "Placement.Base.y": "-{V}.ElbowHalfW",
         "Placement.Base.z": "-{V}.ElbowBot"})
    add(doc, j, "AdditiveBox", "Rod_Bar",
        {"Length": "{V}.JointReach", "Width": "{V}.LeverWidth",
         "Height": "{V}.LeverThk",
         "Placement.Base.x": "-{V}.LeverLen",
         "Placement.Base.y": "-{V}.LeverWidth / 2",
         "Placement.Base.z": "{V}.JointPlateZ"})
    add(doc, j, "AdditiveCylinder", "Rod_Eye",
        {"Radius": "{V}.JointEyeR", "Height": "{V}.LeverThk",
         "Placement.Base.x": "-{V}.LeverLen",
         "Placement.Base.z": "{V}.JointPlateZ"})
    # жёлоб режется ПОСЛЕ планки: там, где планка попала в зону трубы,
    # материал уходит, и труба садится в хомут без натяга
    add(doc, j, "SubtractiveCylinder", "Rod_Groove",
        {"Radius": "{V}.TubeOD / 2", "Height": "{V}.JointGrip + 1 mm",
         "Placement.Base.x": "{V}.Tube2X0"}, rot=ROT_X)
    _clamp_screws(doc, j, xs, "-{V}.ElbowBot", "{V}.ElbowBot + 2 mm", pfx="Rod")
    add(doc, j, "SubtractiveCylinder", "Rod_Hole",
        {"Radius": "{V}.LeverHoleD / 2", "Height": "{V}.LeverThk + 2 mm",
         "Placement.Base.x": "-{V}.LeverLen",
         "Placement.Base.z": "{V}.JointPlateZ - 1 mm"})
    setx(j, "Placement.Base.x", "{V}.PivotX")
    setx(j, "Placement.Base.z", "{V}.Tube2Z")
    setx(j, "Placement.Rotation.Angle", "{V}.Tube2Angle")
    doc.recompute()
    show_tip(j)

    jcap = _clamp_cap(doc, part, JNTCAP_NAME, JNTCAP_LABEL,
                      "{V}.Tube2X0", "{V}.JointGrip", xs, pfx="RdC")
    setx(jcap, "Placement.Base.x", "{V}.PivotX")
    setx(jcap, "Placement.Base.z", "{V}.Tube2Z")
    setx(jcap, "Placement.Rotation.Angle", "{V}.Tube2Angle")
    return j, jcap


LIB_PIVOT_BRG = "Mechanical Parts/Bearings/623ZZ_Ball_Bearing.fcstd"


def build_pivot_hw(doc, part, vs):
    """Подшипник шарнира, его винт и гайка.

    Винт идёт СВЕРХУ: головка прижимает внутреннее кольцо к проушине
    хомута 1, гайка сидит в пазу под проушиной. Наружное кольцо
    запрессовано в хомут 2, поэтому хомут 2 свободно вращается, а винт
    ничего к нему не притягивает.
    """
    for o in list(doc.Objects):
        if o.Name.startswith("PV_"):
            doc.removeObject(o.Name)
    doc.recompute()
    brg = lib_rigid(LIB_PIVOT_BRG)
    if brg is not None:
        # у 623ZZ собственный Placement разворачивает ось на Y; сырая
        # геометрия смотрит ровно по Z и лежит в z 0..PivotBrgW — это и
        # нужно для вертикального шарнира
        brg = brg.copy()
        brg.Placement = App.Placement()
    need = (vs.PivotBrgW.Value + vs.ElbowBot.Value)
    length = next((L for L in LIB_SCREW_LENGTHS if L >= need), LIB_SCREW_LENGTHS[-1])
    screw = lib_shape(LIB_SCREWS % length)
    nut = lib_shape(LIB_NUT)
    made = 0
    for name, label, shape, zexpr, color in (
            ("PV_Brg", "Подшипник_623ZZ_шарнир", brg,
             "{V}.TubeAxisZ", (0.62, 0.64, 0.67)),
            ("PV_Screw", "Винт_шарнира_M3x%d" % length, screw,
             "{V}.TubeAxisZ + {V}.PivotBrgW", (0.30, 0.32, 0.35)),
            ("PV_Nut", "Гайка_шарнира_M3", nut,
             "{V}.TubeAxisZ - {V}.ElbowBot", (0.55, 0.56, 0.58))):
        if shape is None:
            print("  шарнир: нет детали для %s, пропускаю" % label)
            continue
        o = doc.addObject("Part::Feature", name)
        o.Shape = shape.copy()
        o.Label = label
        part.addObject(o)
        setx(o, "Placement.Base.x", "{V}.PivotX")
        setx(o, "Placement.Base.z", zexpr)
        if App.GuiUp:
            o.ViewObject.ShapeColor = color
            o.ViewObject.DiffuseColor = [color]
        made += 1
    doc.recompute()
    return made, length


# хомуты локтя: (тег, локальные X винтов, база Z тела, угол поворота тела)
ELBOW_CLAMPS = (
    ("E1", ("-{V}.ElbowScrewX1", "-{V}.ElbowScrewX2"), "{V}.TubeAxisZ", "0 deg"),
    ("E2", ("{V}.Elbow2ScrewX", "-{V}.Elbow2ScrewX"), "{V}.Tube2Z",
     "{V}.Tube2Angle"),
    ("RJ", ("{V}.JointMidX + {V}.JointScrewX", "{V}.JointMidX - {V}.JointScrewX"),
     "{V}.Tube2Z", "{V}.Tube2Angle"),
)
ELBOW_CLAMP_LABELS = {"E1": "локоть_1", "E2": "локоть_2", "RJ": "тяга"}


def build_elbow_hw(doc, part, vs):
    """Винты и гайки всех трёх хомутов локтя: 1-й трубы, 2-й трубы и тяги.

    Схема та же, что на хомуте шкива: винт сверху через зенковку в
    крышке, гайка в пазу на нижней грани хомута. Головка садится на дно
    зенковки (CapThk - CapWall), гайка — на низ хомута (-ElbowBot).

    Хомут 2 и хомут тяги ПОВЁРНУТЫ на Tube2Angle, а крепёж живёт в
    координатах парта, поэтому положение каждого винта считается
    выражением с поворотом:

        x = PivotX + lx * cos(a) - ly * sin(a)
        y =          lx * sin(a) + ly * cos(a)

    Гайку тоже доворачиваем на Tube2Angle — шестигранник паза повёрнут
    вместе с телом, а у гайки симметрия 60°, так что -90° её не спасают.
    """
    for o in list(doc.Objects):
        if o.Name.startswith("EH_"):
            doc.removeObject(o.Name)
    doc.recompute()

    # длина: от дна зенковки до низа хомута, чтобы резьба прошла гайку
    # насквозь (гайка стоит на самом низу, высотой NutThk)
    need = vs.CapThk.Value - vs.CapWall.Value + vs.ElbowBot.Value
    length = next((L for L in LIB_SCREW_LENGTHS if L >= need), LIB_SCREW_LENGTHS[-1])
    screw = lib_shape(LIB_SCREWS % length)
    nut = lib_shape(LIB_NUT)
    if screw is None or nut is None:
        print("  крепёж локтя: библиотека деталей недоступна, пропускаю")
        return None, 0

    made = 0
    for tag, xs, zbase, ang in ELBOW_CLAMPS:
        for i, lx in enumerate(xs):
            for sy in ("p", "m"):
                ly = ("" if sy == "p" else "-") + "{V}.ElbowScrewY"
                xe = ("{V}.PivotX + (%s) * cos(%s) - (%s) * sin(%s)"
                      % (lx, ang, ly, ang))
                ye = "(%s) * sin(%s) + (%s) * cos(%s)" % (lx, ang, ly, ang)
                for kind, shape, zexpr, color in (
                        ("Vint", screw,
                         "%s + {V}.CapThk - {V}.CapWall" % zbase,
                         (0.30, 0.32, 0.35)),
                        ("Gayka", nut, "%s - {V}.ElbowBot" % zbase,
                         (0.55, 0.56, 0.58))):
                    o = doc.addObject("Part::Feature",
                                      "EH_%s_%s%d%s" % (kind, tag, i + 1, sy))
                    o.Shape = shape.copy()
                    o.Label = ("Винт_%s_M3x%d_%d%s" % (ELBOW_CLAMP_LABELS[tag],
                                                       length, i + 1, sy)
                               if kind == "Vint" else
                               "Гайка_%s_M3_%d%s" % (ELBOW_CLAMP_LABELS[tag],
                                                     i + 1, sy))
                    part.addObject(o)
                    setx(o, "Placement.Base.x", xe)
                    setx(o, "Placement.Base.y", ye)
                    setx(o, "Placement.Base.z", zexpr)
                    setx(o, "Placement.Rotation.Angle", ang)
                    if App.GuiUp:
                        o.ViewObject.ShapeColor = color
                        o.ViewObject.DiffuseColor = [color]
                    made += 1
    doc.recompute()
    return length, made


def build_motor2(doc):
    """Поднять правый мотор на венец второго шкива и повесить на него
    ведущий шкив.

    Шкив — App::Link на уже существующий Шкив_ведущий_20T: он
    сделан эскизами с жёстко заданными 20 зубьями, поэтому копировать
    геометрию незачем, достаточно ссылки. Правка оригинала отразится на
    обоих.
    """
    motor = doc.getObject(MOTOR2_NAME)
    drv   = doc.getObject(DRIVER_NAME)
    if motor is None or drv is None:
        print("  моторы: не нашёл %s / %s, пропускаю" % (MOTOR2_NAME, DRIVER_NAME))
        return None
    setx(motor, "Placement.Base.x", "{V}.Motor2X")
    setx(motor, "Placement.Base.y", "{V}.Motor2Y")
    setx(motor, "Placement.Base.z", "{V}.Motor2Lift")

    link = doc.getObject(DRV2_NAME)
    if link is None:
        link = doc.addObject("App::Link", DRV2_NAME)
        link.LinkedObject = drv
        link.LinkTransform = True      # сохранить собственный Placement оригинала
        parent = [o for o in drv.InList if o.TypeId == "App::Part"]
        if parent:
            parent[0].addObject(link)
    link.Label = DRV2_LABEL
    setx(link, "Placement.Base.x", "{V}.Motor2X")
    setx(link, "Placement.Base.y", "{V}.Motor2Y")
    setx(link, "Placement.Base.z", "{V}.Motor2Lift")
    doc.recompute()
    return link


def build_spacer(doc, part):
    """Труба между первым и вторым шкивом.

    Садится на ступицу первого шкива и поднимает второй выше крышки
    хомута, чтобы тот её не задевал. Внутренний Ø — та же ось, что
    проходит через отверстие в ступице (ShaftHoleD).
    """
    old = doc.getObject(PROST_NAME)
    if old is not None:
        wipe(doc, old)
        doc.removeObject(old.Name)
        doc.recompute()
    purge_orphans(doc)
    body = doc.addObject("PartDesign::Body", PROST_NAME)
    part.addObject(body)
    body.Label = PROST_LABEL

    add(doc, body, "AdditiveCylinder", "S_Tube",
        {"Radius": "{V}.SpacerOD / 2", "Height": "{V}.SpacerH",
         "Placement.Base.z": "{V}.PulleyH"})
    add(doc, body, "SubtractiveCylinder", "S_Bore",
        {"Radius": "{V}.SpacerID / 2", "Height": "{V}.SpacerH + 2 mm",
         "Placement.Base.z": "{V}.PulleyH - 1 mm"})
    doc.recompute()
    show_tip(body)
    return body


LIB_SCREWS = ("Mechanical Parts/Fasteners/Bolts & Screws/Metric/"
              "ISO4762_Hex_Socket_Head_Cap_Screw_M3x%d.fcstd")
LIB_SCREW_LENGTHS = (10, 12, 16, 18, 20, 22, 25, 35)   # что есть в библиотеке
LIB_NUT = "Mechanical Parts/Fasteners/Nuts/Metric/ISO4032_Hex_Nut_M3.fcstd"
LIB_BEARING = "Mechanical Parts/Bearings/608ZZ_Ball_Bearing.fcstd"


def lib_shape(rel):
    """Достать геометрию детали из библиотеки и запечь её Placement.

    У Part::Feature свойство Placement и Shape.Placement — одно и то же,
    поэтому собственный разворот библиотечной детали надо внести прямо
    в геометрию, иначе он потеряется при первом же присвоении Placement.
    """
    import os
    path = os.path.join(App.getUserAppDataDir(), "Mod", "parts_library", rel)
    if not os.path.exists(path):
        return None
    d = App.openDocument(path)
    try:
        best = None
        for o in d.Objects:
            sh = getattr(o, "Shape", None)
            if sh is None or sh.isNull() or sh.Volume < 1e-9:
                continue
            best = o.Shape.copy()          # последняя фича цепочки = готовая деталь
        if best is None:
            return None
        m = best.Placement.toMatrix()
        best.Placement = App.Placement()
        return best.transformGeometry(m)
    finally:
        App.closeDocument(d.Name)


def lib_rigid(rel):
    """Достать деталь из библиотеки, сохранив её Placement как есть.

    Отличие от lib_shape: без transformGeometry. Тот пересобирает
    поверхности в B-сплайны, и на 608ZZ это заметно — объём уехал на 1%,
    цилиндрические грани исчезли, а BoundBox стал считаться по
    контрольным точкам и показывал 33x38x7 вместо 22x22x7. Для жёсткого
    поворота пересборка не нужна: Part::Feature наследует Placement
    шейпа вместе с разворотом, остаётся задать только смещение.
    """
    import os
    path = os.path.join(App.getUserAppDataDir(), "Mod", "parts_library", rel)
    if not os.path.exists(path):
        return None
    d = App.openDocument(path)
    try:
        best = None
        for o in d.Objects:
            sh = getattr(o, "Shape", None)
            if sh is None or sh.isNull() or sh.Volume < 1e-9:
                continue
            best = o.Shape.copy()      # последняя фича цепочки = готовая деталь
        return best
    finally:
        App.closeDocument(d.Name)


def build_bearings(doc, part):
    """Подшипники обоих шкивов из библиотеки.

    У первого гнездо открыто вниз, у второго — вверх (снизу ступицу
    занимает рычаг). Разворот осью по Z у библиотечной детали уже зашит
    в Placement шейпа, геометрия центрирована — поэтому задаём только
    смещение на половину толщины.
    """
    for o in list(doc.Objects):
        if o.Name.startswith("BRG_"):
            doc.removeObject(o.Name)
    doc.recompute()
    sh = lib_rigid(LIB_BEARING)
    if sh is None:
        print("  подшипники: библиотека деталей недоступна, пропускаю")
        return 0
    color = (0.62, 0.64, 0.67)
    made = 0
    for name, label, zexpr in (
            ("BRG_1", "Подшипник_608ZZ_1", "{V}.BrgW / 2"),
            ("BRG_2", "Подшипник_608ZZ_2", "{V}.BrgZ2 + {V}.BrgW2 / 2")):
        o = doc.addObject("Part::Feature", name)
        o.Shape = sh.copy()        # Placement с разворотом приходит вместе с ним
        o.Label = label
        part.addObject(o)
        setx(o, "Placement.Base.z", zexpr)
        if App.GuiUp:
            o.ViewObject.ShapeColor = color
            o.ViewObject.DiffuseColor = [color]
        made += 1
    doc.recompute()
    return made


def build_hardware(doc, part, vs):
    """Винты и гайки из библиотеки, расставленные по пазам хомута."""
    for o in list(doc.Objects):
        if o.Name.startswith("HW_"):
            doc.removeObject(o.Name)
    doc.recompute()

    need = (vs.TubeAxisZ.Value + vs.CapThk.Value - vs.CapWall.Value
            - vs.NutZ.Value)
    length = next((L for L in LIB_SCREW_LENGTHS if L >= need), LIB_SCREW_LENGTHS[-1])
    screw = lib_shape(LIB_SCREWS % length)
    nut = lib_shape(LIB_NUT)
    if screw is None or nut is None:
        print("  крепёж: библиотека деталей недоступна, пропускаю")
        return None, 0

    made = 0
    for i, (sx, sy) in enumerate([("ScrewX1", "+"), ("ScrewX1", "-"),
                                  ("ScrewX2", "+"), ("ScrewX2", "-")]):
        ey = ("" if sy == "+" else "-") + "{V}.ScrewY"
        for kind, shape, zexpr, rot, color in (
                ("Vint",  screw, "{V}.TubeAxisZ + {V}.CapThk - {V}.CapWall",
                 None, (0.30, 0.32, 0.35)),
                # доворот гайке не нужен: её грани уже совпадают с пазом.
                # Проверено подбором — габаритная коробка скруглённой детали
                # ориентацию шестигранника не показывает.
                ("Gayka", nut, "{V}.NutZ", None, (0.55, 0.56, 0.58))):
            o = doc.addObject("Part::Feature", "HW_%s%d" % (kind, i + 1))
            o.Shape = shape.copy()
            o.Label = ("Винт_M3x%d_%d" % (length, i + 1) if kind == "Vint"
                       else "Гайка_M3_%d" % (i + 1))
            part.addObject(o)
            if rot is not None:
                pl = o.Placement
                pl.Rotation = rot
                o.Placement = pl
            setx(o, "Placement.Base.x", "{V}." + sx)
            setx(o, "Placement.Base.y", ey)
            setx(o, "Placement.Base.z", zexpr)
            o.ViewObject.ShapeColor = color
            o.ViewObject.DiffuseColor = [color]
            made += 1
    doc.recompute()
    return length, made


def main():
    doc = pick_doc()
    body = doc.getObject(BODY_NAME)
    part = doc.getObject(PART_NAME)
    print("документ:", doc.Name, "|", doc.FileName)

    vs, created = ensure_varset(doc)
    print("набор переменных '%s' %s" % (vs.Label, "создан" if created else "найден, значения сохранены"))

    build_pulley(doc, body)
    cap = build_cap(doc, part)
    prost = build_spacer(doc, part)
    pul2 = build_pulley2(doc, part)
    screw_len, hw_n = build_hardware(doc, part, vs)
    brg_n = build_bearings(doc, part)
    tube = build_tube(doc)
    elbow, acap, elbow2, bcap, tube2 = build_elbow(doc, doc.getObject(TUBE_PART))
    pv_n, pv_len = build_pivot_hw(doc, doc.getObject(TUBE_PART), vs)
    joint, jcap = build_rod_joint(doc, doc.getObject(TUBE_PART))
    eh_len, eh_n = build_elbow_hw(doc, doc.getObject(TUBE_PART), vs)
    drv2 = build_motor2(doc)

    # узел целиком отъезжает от вала мотора на межосевое расстояние
    # и садится по высоте так, чтобы венцы ведущего и ведомого совпали
    setx(part, "Placement.Base.y", "{V}.CenterDist")
    setx(part, "Placement.Base.z", "{V}.BeltPlaneZ - {V}.FlangeThk")
    doc.recompute()

    # ---------------- отчёт ----------------
    sh = body.Shape
    bb = sh.BoundBox
    v = sh.Volume / 1000.0
    cv = cap.Shape.Volume / 1000.0
    print("")
    print("  передача   %d -> %d зубьев, i = %.3f (задано %.3f)"
          % (vs.DriverTeeth, vs.DrivenTeeth, vs.RatioActual, vs.Ratio))
    print("  шкив       делительный Ø%.3f | вершины Ø%.3f | фланец Ø%.3f"
          % (vs.PitchD2, vs.TipD, vs.FlangeD))
    print("  ремень     GT2-%.0f, %.0f мм ширина -> межосевое %.3f мм"
          % (vs.BeltLength, vs.BeltWidth, vs.CenterDist))
    print("             запас длины %+.1f мм (минимум %.1f), зубьев в зацеплении %.1f"
          % (vs.BeltSlack, vs.BeltMin, vs.TeethInMesh))
    if vs.BeltSlack <= 0:
        print("  !! РЕМЕНЬ КОРОТОК для такой передачи — возьмите длиннее "
              "или уменьшите Ratio")
    elif vs.TeethInMesh < 6:
        print("  !! в зацеплении меньше 6 зубьев — ремень будет проскакивать")
    print("  положение  узел на (0, %.3f, %.3f) от вала мотора"
          % (part.Placement.Base.y, part.Placement.Base.z))
    z0 = part.Placement.Base.z + vs.FlangeThk.Value
    print("             венец ведомого z %.3f..%.3f, ведущего %.3f..%.3f"
          % (z0, z0 + vs.RimH.Value,
             vs.BeltPlaneZ.Value, vs.BeltPlaneZ.Value + vs.RimH.Value))
    print("  труба      Ø%.1f, хомут %.0f мм, ось на z=%.1f от низа шкива"
          % (vs.TubeOD, vs.ClampLen, vs.TubeAxisZ))
    print("  окна шкив1 %d шт по %.0f°, R %.1f..%.1f (спица под седлом руки)"
          % (vs.WindowCount, vs.WindowAngle, vs.WindowRin, vs.WindowRout))
    print("  окна шкив2 %d шт по %.0f°, R %.1f..%.1f (спица под рычагом)"
          % (vs.WindowCount2, vs.WindowAngle2, vs.WindowRin2, vs.WindowRout2))
    vint_len = (vs.TubeAxisZ.Value + vs.CapThk.Value - vs.CapWall.Value
                - vs.NutZ.Value)
    print("  винты      шаг %.1f x %.1f мм, нужно не меньше %.1f мм"
          % (vs.ScrewX2 - vs.ScrewX1, 2 * vs.ScrewY, vint_len))
    print("  пазы гаек  %.1f x %.1f, открыты вниз и вбок (гайка заводится сбоку)"
          % (vs.NutAF, vs.NutThk))
    if screw_len:
        print("  крепёж     %d шт из библиотеки: ISO4762 M3x%d + ISO4032 гайка M3"
              % (hw_n, screw_len))
    print("  шкив+седло %.2f x %.2f x %.2f мм | %.1f см3 (PLA ~%.0f г) | тел %d, валидно %s"
          % (bb.XLength, bb.YLength, bb.ZLength, v, v * 1.24, len(sh.Solids), sh.isValid()))
    print("  крышка     %.1f см3 (PLA ~%.0f г) | тел %d, валидно %s"
          % (cv, cv * 1.24, len(cap.Shape.Solids), cap.Shape.isValid()))
    pv = prost.Shape.Volume / 1000.0
    print("  проставка  Ø%.1f/Ø%.1f x %.1f мм (стенка %.1f) | %.1f см3 (PLA ~%.0f г)"
          % (vs.SpacerOD, vs.SpacerID, vs.SpacerH, vs.SpacerWall,
             pv, pv * 1.24))
    print("             верх проставки на %.1f мм выше верха крышки хомута"
          % vs.SpacerGap)
    p2v = pul2.Shape.Volume / 1000.0
    print("  ступень 2  %d -> %d зубьев, i = %.3f (задано %.3f) | вершины Ø%.3f"
          % (vs.DriverTeeth2, vs.DrivenTeeth2, vs.RatioActual2, vs.Ratio2,
             vs.TipD2))
    print("             ремень GT2-%.0f -> межосевое %.3f мм, запас %+.1f мм, "
          "зубьев в зацеплении %.1f"
          % (vs.BeltLength2, vs.CenterDist2, vs.BeltSlack2, vs.TeethInMesh2))
    if vs.BeltSlack2 <= 0:
        print("  !! РЕМЕНЬ 2 КОРОТОК для этой передачи")
    elif vs.TeethInMesh2 < 6:
        print("  !! у второй ступени в зацеплении меньше 6 зубьев")
    if vs.CenterDist2.Value < vs.Motor2X.Value:
        print("  !! CenterDist2 (%.1f) меньше Motor2X (%.1f) — правый мотор так "
              "не поставить, нужен ремень длиннее"
              % (vs.CenterDist2, vs.Motor2X))
    print("  шкив 2     без хомута | %.1f см3 (PLA ~%.0f г)" % (p2v, p2v * 1.24))
    print("             низ фланца z=%.1f, венец z=%.1f..%.1f от низа первого шкива"
          % (vs.Pulley2Z, vs.BeltPlaneZ2, vs.BeltPlaneZ2.Value + vs.RimH.Value))
    print("  подшипники %d шт 608ZZ, оба гнезда открыты вниз: шкив 1 "
          "z 0..%.0f, шкив 2 z %.1f..%.1f"
          % (brg_n, vs.BrgW, vs.BrgZ2.Value, vs.BrgZ2.Value + vs.BrgW.Value))
    print("             упор шкива 1 %.1f мм Ø%.1f, шкива 2 %.1f мм Ø%.1f"
          % (vs.PulleyH.Value - vs.BrgW.Value, vs.ShaftHoleD,
             vs.ShoulderThk2, vs.ShaftHoleD2))
    if vs.ShoulderThk2 <= 0:
        print("  !! у верхнего шкива упор нулевой: BrgW2 >= PulleyH2")
    if abs(vs.BrgOD2.Value - 22.0) > 1e-6 or abs(vs.BrgW2.Value - 7.0) > 1e-6:
        print("  !! BrgOD2/BrgW2 уже не 608ZZ (22x7) — деталь из библиотеки "
              "в гнездо не сядет, меняйте LIB_BEARING")
    print("  рычаг      R%.0f..%.0f до отверстия Ø%.1f, %.0f x %.0f мм, "
          "часть фланца, угол %.0f°"
          % (vs.LeverR0, vs.LeverLen, vs.LeverHoleD, vs.LeverWidth,
             vs.LeverThk, vs.LeverAngle))
    tv = tube.Shape.Volume / 1000.0
    print("  труба      Ø%.1f x %.0f мм, стенка %.1f | отдельный парт «%s» | %.1f см3"
          % (vs.TubeOD, vs.TubeLen, vs.TubeWall, TUBE_PLABEL, tv))
    ev = (elbow.Shape.Volume + acap.Shape.Volume) / 1000.0
    e2v = (elbow2.Shape.Volume + bcap.Shape.Volume) / 1000.0
    t2v = tube2.Shape.Volume / 1000.0
    print("  локоть     ось шарнира на x=%.1f от оси шкива | хомут 1 + крышка "
          "%.1f см3, хомут 2 + крышка %.1f см3"
          % (vs.PivotX, ev, e2v))
    print("             подшипник %d шт 623ZZ Ø%.0f x %.0f, винт M3x%d сверху, "
          "гайка в пазу проушины"
          % (pv_n and 1, vs.PivotBrgOD, vs.PivotBrgW, pv_len))
    print("             хомуты на винтах M3: по 4 шт, гайки в пазах снизу, "
          "нужно не меньше %.1f мм"
          % (vs.CapThk.Value - vs.CapWall.Value + vs.ElbowBot.Value - vs.NutThk.Value))
    print("  труба 2    Ø%.1f x %.0f мм насквозь через хомут 2, угол %.0f° | "
          "вылет %.0f + рабочая %.0f | %.1f см3"
          % (vs.TubeOD, vs.Tube2Full, vs.Tube2Angle,
             vs.LeverLen.Value - vs.JointReach.Value, vs.Tube2Len, t2v))
    jv = (joint.Shape.Volume + jcap.Shape.Volume) / 1000.0
    la = math.radians(vs.LeverAngle.Value)
    ta = math.radians(vs.Tube2Angle.Value)
    hx = vs.LeverLen.Value * math.cos(la)
    hy = vs.LeverLen.Value * math.sin(la)
    px = vs.PivotX.Value - vs.LeverLen.Value * math.cos(ta)
    py = -vs.LeverLen.Value * math.sin(ta)
    span = math.hypot(px - hx, py - hy)
    print("  шарнир тяги палец на %.0f мм (= LeverLen) от оси локтя, проушина "
          "в полосе z %.1f..%.1f — ровно полоса рычага | хомут %.0f мм + "
          "крышка | %.1f см3"
          % (vs.LeverLen, vs.LeverZ, vs.LeverZ.Value + vs.LeverThk.Value,
             vs.JointGrip, jv))
    print("             труба 2 кончается за %.1f мм до пальца, пролёт "
          "закрывает планка | тяга плоская: Ø%.1f x 2, межцентровое %.2f мм"
          % (vs.JointReach, vs.LeverHoleD, span))
    if vs.LeverZ.Value + vs.LeverThk.Value > vs.Tube2Z.Value + 1e-6:
        print("  !! полоса рычага выше оси трубы 2 — планка проушины полезет в "
              "крышку хомута: уменьшите LeverThk или поднимите трубу 2 "
              "(PivotHeadC)")
    if vs.LeverZ.Value < vs.Tube2Z.Value - vs.ElbowBot.Value - 1e-6:
        print("  !! полоса рычага ниже хомута тяги — планка оторвётся от его "
              "торцевой стенки")
    free = vs.LeverLen.Value - vs.JointReach.Value - vs.ElbowGrip.Value / 2
    if vs.JointGrip.Value + vs.JointWall.Value > free:
        print("  !! хомут тяги (%.0f + стенка %.0f) не влезает между локтем и "
              "пальцем (%.1f мм): уменьшите JointGrip или удлините рычаг"
              % (vs.JointGrip, vs.JointWall, free))
    if vs.JointScrewX.Value <= 0:
        print("  !! JointGrip меньше 12 мм — винтам хомута тяги некуда встать")
    if eh_len:
        print("  крепёж локтя %d шт из библиотеки: ISO4762 M3x%d + гайка M3, "
              "по 4 винта на хомут 1, хомут 2 и хомут тяги"
              % (eh_n, eh_len))
    if drv2 is not None:
        print("  мотор 2    (x=%.1f, y=%.1f, z=+%.1f), межосевое %.3f, "
              "ведущий шкив — ссылка на «%s»"
              % (vs.Motor2X, vs.Motor2Y, vs.Motor2Lift, vs.CenterDist2,
                 doc.getObject(DRIVER_NAME).Label))
        if vs.DriverTeeth2 != 20:
            print("  !! DriverTeeth2 = %d, а ведущий шкив в модели — эскизный 20T. "
                  "Расчёт второй ступени и геометрия шкива расходятся"
                  % vs.DriverTeeth2)
    if abs(vs.SpacerID.Value - vs.ShaftHoleD.Value) > 1e-6:
        print("  !! SpacerID (%.1f) не равен ShaftHoleD (%.1f) — ось не одна"
              % (vs.SpacerID, vs.ShaftHoleD))

    if App.GuiUp:
        import FreeCADGui as Gui
        Gui.activeDocument().activeView().viewIsometric()
        Gui.SendMsgToActiveView("ViewFit")


if __name__ == "__main__":
    main()
