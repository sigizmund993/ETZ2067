# производные: (имя, тип, группа, выражение, подсказка)
DERIVED = [
    ("DrivenTeeth",   "App::PropertyInteger", "5 Расчёт", "round({V}.DriverTeeth * {V}.Ratio)",
     "Зубьев на ведомом шкиве (целое)"),
    ("RatioActual", "App::PropertyFloat", "5 Расчёт", "{V}.DrivenTeeth / {V}.DriverTeeth",
     "Фактическая передача после округления зубьев"),
    ("PitchD1",    "App::PropertyLength",  "5 Расчёт", "{V}.DriverTeeth * {V}.BeltPitch / pi",
     "Делительный Ø ведущего"),
    ("PitchD2",    "App::PropertyLength",  "5 Расчёт", "{V}.DrivenTeeth * {V}.BeltPitch / pi",
     "Делительный Ø ведомого"),
    ("TipD",  "App::PropertyLength",  "5 Расчёт", "{V}.PitchD2 - 0.508 mm",
     "Ø по вершинам зубьев ведомого"),
    ("FlangeD",    "App::PropertyLength",  "5 Расчёт", "{V}.TipD + 2 * {V}.FlangeLip",
     "Наружный Ø фланцев"),
    # межосевое: C = (b + sqrt(b^2 - 8Q)) / 4,  b = L - pi(D1+D2)/2,  Q = (D2-D1)^2/4
    ("BeltB",     "App::PropertyLength",  "5 Расчёт",
     "{V}.BeltLength - pi * ({V}.PitchD1 + {V}.PitchD2) / 2", "Промежуточная величина b"),
    ("BeltQ",     "App::PropertyArea",    "5 Расчёт",
     "({V}.PitchD2 - {V}.PitchD1) ^ 2 / 4", "Промежуточная величина Q"),
    # max(...; 0) обязателен: при слишком коротком ремне подкоренное уходит
    # в минус, sqrt даёт nan, и узел уезжает в неопределённую точку.
    ("CenterDist",     "App::PropertyLength",  "5 Расчёт",
     "({V}.BeltB + sqrt(max({V}.BeltB ^ 2 - 8 * {V}.BeltQ; 0 mm^2) / 1mm^2) * 1mm) / 4",
     "МЕЖОСЕВОЕ расстояние от вала мотора — на него сдвинут весь узел"),
    ("BeltMin",   "App::PropertyLength",  "5 Расчёт",
     "({V}.PitchD1 + {V}.PitchD2) + pi * ({V}.PitchD1 + {V}.PitchD2) / 2"
     " + ({V}.PitchD2 - {V}.PitchD1) ^ 2 / (2 * ({V}.PitchD1 + {V}.PitchD2))",
     "Абсолютный минимум длины ремня для этих шкивов (шкивы вплотную)"),
    ("BeltSlack","App::PropertyLength",  "5 Расчёт",
     "{V}.BeltLength - {V}.BeltMin",
     "Запас длины ремня. <= 0 означает, что ремень физически не налезет"),
    ("TeethInMesh", "App::PropertyFloat", "5 Расчёт",
     "(180 - 2 * asin(({V}.PitchD2 - {V}.PitchD1) / (2 * {V}.CenterDist)) / 1deg) / 360"
     " * {V}.DriverTeeth",
     "Зубьев ведущего шкива в зацеплении. Меньше 6 — ремень будет проскакивать"),

    # --- вторая ступень: свои зубья и диаметры, межосевое общее ---
    # Шкивы соосны, поэтому межосевое у второй ступени то же самое, а вот
    # длина ремня из него уже выводится, а не задаётся.
    ("DrivenTeeth2",  "App::PropertyInteger", "5 Расчёт 2",
     "round({V}.DriverTeeth2 * {V}.Ratio2)", "Зубьев на верхнем ведомом шкиве"),
    ("RatioActual2", "App::PropertyFloat", "5 Расчёт 2",
     "{V}.DrivenTeeth2 / {V}.DriverTeeth2", "Фактическая передача второй ступени"),
    ("PitchDriver2", "App::PropertyLength", "5 Расчёт 2",
     "{V}.DriverTeeth2 * {V}.BeltPitch / pi", "Делительный Ø ведущего 2"),
    ("PitchDriven2",  "App::PropertyLength", "5 Расчёт 2",
     "{V}.DrivenTeeth2 * {V}.BeltPitch / pi", "Делительный Ø верхнего ведомого"),
    ("TipD2", "App::PropertyLength",  "5 Расчёт 2",
     "{V}.PitchDriven2 - 0.508 mm", "Ø по вершинам зубьев верхнего шкива"),
    ("FlangeD2",   "App::PropertyLength",  "5 Расчёт 2",
     "{V}.TipD2 + 2 * {V}.FlangeLip2", "Наружный Ø фланцев верхнего шкива"),
    # межосевое второй ступени — та же формула длины ремня, что у первой
    ("BeltB2",     "App::PropertyLength", "5 Расчёт 2",
     "{V}.BeltLength2 - pi * ({V}.PitchDriver2 + {V}.PitchDriven2) / 2",
     "Промежуточная величина b второй ступени"),
    ("BeltQ2",     "App::PropertyArea",   "5 Расчёт 2",
     "({V}.PitchDriven2 - {V}.PitchDriver2) ^ 2 / 4",
     "Промежуточная величина Q второй ступени"),
    ("CenterDist2","App::PropertyLength", "5 Расчёт 2",
     "({V}.BeltB2 + sqrt(max({V}.BeltB2 ^ 2 - 8 * {V}.BeltQ2; 0 mm^2) / 1mm^2)"
     " * 1mm) / 4",
     "МЕЖОСЕВОЕ второй ступени: от вала правого мотора до общей оси шкивов"),
    ("BeltMin2",   "App::PropertyLength", "5 Расчёт 2",
     "({V}.PitchDriver2 + {V}.PitchDriven2)"
     " + pi * ({V}.PitchDriver2 + {V}.PitchDriven2) / 2"
     " + ({V}.PitchDriven2 - {V}.PitchDriver2) ^ 2"
     " / (2 * ({V}.PitchDriver2 + {V}.PitchDriven2))",
     "Минимум длины ремня второй ступени (шкивы вплотную)"),
    ("BeltSlack2", "App::PropertyLength", "5 Расчёт 2",
     "{V}.BeltLength2 - {V}.BeltMin2", "Запас длины ремня второй ступени"),
    ("TeethInMesh2", "App::PropertyFloat", "5 Расчёт 2",
     "(180 - 2 * asin(({V}.PitchDriven2 - {V}.PitchDriver2) / (2 * {V}.CenterDist2))"
     " / 1deg) / 360 * {V}.DriverTeeth2",
     "Зубьев ведущего 2 в зацеплении. Меньше 6 — ремень будет проскакивать"),

    # --- габариты верхнего шкива, все от своих переменных ---
    ("RimH2",  "App::PropertyLength", "6 Производные 2",
     "{V}.BeltWidth2 + 1 mm", "Высота венца верхнего шкива"),
    ("PulleyH2", "App::PropertyLength", "6 Производные 2",
     "2 * {V}.FlangeThk2 + {V}.RimH2", "Полная высота верхнего шкива"),
    ("WindowRin2",      "App::PropertyLength", "6 Производные 2",
     "{V}.BrgOD2 / 2 + {V}.WindowGapIn2",
     "Внутренний радиус окон верхнего шкива"),
    ("WindowRout2",     "App::PropertyLength", "6 Производные 2",
     "{V}.TipD2 / 2 - {V}.WindowGapOut2",
     "Наружный радиус окон верхнего шкива"),
    ("WindowPhase2",     "App::PropertyAngle",  "6 Производные 2",
     "180 deg / {V}.WindowCount2 - {V}.WindowAngle2 / 2",
     "Доворот первого окна верхнего шкива, чтобы спица пришлась под рычаг"),
    ("ShoulderThk2",    "App::PropertyLength", "6 Производные 2",
     "{V}.PulleyH2 - {V}.BrgW2",
     "Толщина упора над подшипником верхнего шкива. <= 0 — подшипник "
     "не во что упереть"),

    ("RimH",  "App::PropertyLength", "6 Производные", "{V}.BeltWidth + 1 mm",
     "Высота венца под ремень"),
    ("PulleyH", "App::PropertyLength", "6 Производные",
     "2 * {V}.FlangeThk + {V}.RimH", "Полная высота шкива"),
    ("SaddleH",  "App::PropertyLength", "6 Производные",
     "{V}.TubeOD / 2 + {V}.SaddleWall", "Высота седла над верхом шкива"),
    ("TubeAxisZ",      "App::PropertyLength", "6 Производные",
     "{V}.PulleyH + {V}.SaddleH", "Высота оси трубы (= верх седла)"),
    ("SaddleHalfW","App::PropertyLength", "6 Производные",
