    ("PivotCeil",    "App::PropertyLength", "6 Производные 2",
     "{V}.PivotHeadC + 1.5 mm",
     "Потолок над гнездом подшипника: карман под головку винта плюс стенка"),
    ("Tube2Z",       "App::PropertyLength", "6 Производные 2",
