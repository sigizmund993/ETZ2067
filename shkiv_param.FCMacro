    # вся высота второго шкива считается от требования «рычаг не задевает
    # крышку хомута»: низ рычага = верх крышки + SpacerGap
    ("Pulley2Z",      "App::PropertyLength", "6 Производные",
     "{V}.TubeAxisZ + {V}.CapThk + {V}.SpacerGap + {V}.LeverThk"
