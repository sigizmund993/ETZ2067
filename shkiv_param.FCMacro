# -*- coding: utf-8 -*-
# shkiv_param.FCMacro
#
# Параметрический ведомый шкив GT2 с седлом под трубу руки и прижимной
# крышкой. Все размеры заданы ОДНИМ набором переменных (VarSet "Привод"),
# который виден в дереве документа — менять их можно прямо в GUI, модель
# пересчитается сама. Макрос нужен только чтобы построить/перестроить
# цепочку фич; после этого он не требуется.
#
# Что завязано на переменные:
#   * диаметр шкива        <- Ratio (передаточное число) и DriverTeeth
#   * положение шкива      <- Ratio и BeltLength (решение формулы ремня)
#   * седло/крышка/винты   <- TubeOD (наружный Ø трубы руки)
#
# Геометрия собрана на примитивах PartDesign (AdditiveCylinder/Box,
# SubtractiveCylinder/Box), а не на эскизах: у примитива каждый размер —
# отдельное свойство, которое можно привязать выражением, и нет привязки
# к именам рёбер (topological naming).
#
# Компоновка как в референсе-драйботе (makerworld 712239): корень руки
# прижимается к верху шкива крышкой на винтах. Там это плоская пластина
# и два винта на 28 мм; здесь — полукруглое седло под трубу и крышка.
#
# Запуск: FreeCAD -> Макросы... -> shkiv_param.FCMacro

import math

import FreeCAD as App

DOC_HINT   = "ETZ_Robot"
PART_NAME  = "Part002"     # контейнер, который двигается на межосевое расстояние
BODY_NAME  = "Body003"     # тело шкива (существующее, переиспользуется)
CAP_NAME   = "Body_Cap"    # тело крышки (создаётся)
PROST_NAME = "Body_Prost"  # тело проставки под второй шкив (создаётся)
VS_NAME    = "Drive"

PULLEY_LABEL = "Шкив_ведомый"
CAP_LABEL    = "Крышка_хомута"
PROST_LABEL  = "Проставка_шкивов"
PUL2_NAME    = "Body_Pulley2"   # второй ведомый шкив (создаётся)
PUL2_LABEL   = "Шкив_ведомый_2"
TUBE_PART    = "Part_Tube"      # отдельный парт с трубой руки (создаётся)
TUBE_BODY    = "Body_Tube"
TUBE_PLABEL  = "Труба_руки"
TUBE_BLABEL  = "Труба_Ø10"
ELBOW_NAME   = "Body_Elbow"     # хомут локтя на трубе 1 (создаётся)
ELBOW_LABEL  = "Локоть_хомут_1"
ELBCAP_NAME  = "Body_ElbowCap"
ELBCAP_LABEL = "Локоть_крышка_1"
ELBOW2_NAME  = "Body_Elbow2"    # хомут локтя на трубе 2, вращается
ELBOW2_LABEL = "Локоть_хомут_2"
ELB2CAP_NAME = "Body_Elbow2Cap"
ELB2CAP_LABEL= "Локоть_крышка_2"
TUBE2_NAME   = "Body_Tube2"     # вторая труба, проходит локоть насквозь
TUBE2_LABEL  = "Труба_2_Ø10"
JOINT_NAME   = "Body_RodJoint"  # шарнир тяги на конце трубы 2
JOINT_LABEL  = "Шарнир_тяги"
JNTCAP_NAME  = "Body_RodJointCap"
JNTCAP_LABEL = "Шарнир_тяги_крышка"
DRV2_NAME    = "Driver2"        # ссылка на ведущий шкив правого мотора
DRV2_LABEL   = "Шкив_ведущий_2"
MOTOR2_NAME  = "Body001"        # правый мотор (существующий)
DRIVER_NAME  = "Pulley"         # ведущий шкив левого мотора (существующий)

# ---------------------------------------------------------------------------
